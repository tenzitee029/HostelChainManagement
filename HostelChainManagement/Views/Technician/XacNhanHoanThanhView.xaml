<UserControl x:Class="QuanLyChuoiNhaTro.Views.Technician.XacNhanHoanThanhView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="viewRoot"
             Background="#F8F9FB"
             Loaded="View_Loaded">

  <UserControl.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="BorderBrush" Value="#D1D7E0"/>
    </Style>

    <Style x:Key="ReadField"
           TargetType="TextBox"
           BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="Background" Value="#F8F9FB"/>
      <Setter Property="Foreground" Value="#64748B"/>
    </Style>

    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="#475569"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#D1D7E0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="3"/>
    </Style>

    <Style x:Key="CardHeader" TargetType="Border">
      <Setter Property="Padding" Value="14,11"/>
      <Setter Property="BorderBrush" Value="#E1E5EC"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
  </UserControl.Resources>

  <Grid x:Name="editorPanel">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Width="{Binding ActualWidth, ElementName=viewRoot}"
                  MaxWidth="850"
                  HorizontalAlignment="Left">

        <TextBlock Text="Xác nhận hoàn thành sửa chữa"
                   FontSize="22"
                   FontWeight="SemiBold"/>

        <TextBlock Text="Ghi nhận kết quả sau khi hoàn tất công việc sửa chữa."
                   Foreground="#7C8798"
                   Margin="0,4,0,12"/>

        <Border Style="{StaticResource Card}"
                Margin="0,0,0,14">
          <StackPanel>
            <Border Style="{StaticResource CardHeader}">
              <TextBlock Text="Công việc đang nghiệm thu"
                         FontWeight="SemiBold"/>
            </Border>

            <Grid Margin="16,20">
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>

              <StackPanel Margin="0,0,14,0">
                <TextBlock Text="Mã yêu cầu"
                           Style="{StaticResource Label}"/>
                <TextBox x:Name="txtCompleteId"
                         Style="{StaticResource ReadField}"/>
              </StackPanel>

              <StackPanel Grid.Column="1">
                <TextBlock Text="Phòng"
                           Style="{StaticResource Label}"/>
                <TextBox x:Name="txtCompleteRoom"
                         Style="{StaticResource ReadField}"/>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <Border Style="{StaticResource CardHeader}">
              <TextBlock Text="Biểu mẫu nghiệm thu"
                         FontWeight="SemiBold"/>
            </Border>

            <StackPanel x:Name="completionEditor"
                        Margin="16">
              <TextBlock Text="Ghi chú cách khắc phục"
                         Style="{StaticResource Label}"/>

              <TextBox x:Name="txtResolution"
                       MaxLength="500"
                       Height="100"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       VerticalContentAlignment="Top"
                       Margin="0,0,0,16"/>

              <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,14,0">
                  <TextBlock Text="Tên linh kiện"
                             Style="{StaticResource Label}"/>
                  <TextBox x:Name="txtMaterialName"
                           MaxLength="100"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="0,0,14,0">
                  <TextBlock Text="Số lượng"
                             Style="{StaticResource Label}"/>
                  <TextBox x:Name="txtQuantity"
                           Text="1"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                  <TextBlock Text="Chi phí"
                             Style="{StaticResource Label}"/>
                  <TextBox x:Name="txtCost"
                           Text="0"
                           ToolTip="Đơn giá mỗi linh kiện, tính bằng VND"/>
                </StackPanel>
              </Grid>

              <TextBlock Text="Ảnh hiện trường sau khi sửa xong"
                         Style="{StaticResource Label}"/>

              <Border BorderBrush="#D1D7E0"
                      BorderThickness="1"
                      Padding="6">
                <DockPanel>
                  <Button DockPanel.Dock="Left"
                          Content="Chọn tệp"
                          Click="ChoosePhoto_Click"
                          Padding="8,3"
                          Margin="0,0,8,0"/>

                  <TextBlock x:Name="txtPhoto"
                             Text="Chưa chọn tệp"
                             Foreground="#64748B"
                             VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis"/>
                </DockPanel>
              </Border>
            </StackPanel>

            <Border BorderBrush="#E1E5EC"
                    BorderThickness="0,1,0,0"
                    Padding="14,12">
              <Button x:Name="btnComplete"
                      Content="Xác nhận hoàn tất"
                      Background="#2563EB"
                      Foreground="White"
                      HorizontalAlignment="Right"
                      Click="Complete_Click"/>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <TextBlock x:Name="txtStatus"
               Grid.Row="1"
               Foreground="#B45309"
               TextWrapping="Wrap"
               Margin="0,12,0,0"/>
  </Grid>
</UserControl>