<Window x:Class="QuanLyChuoiNhaTro.Views.Management.QuanLyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nhân viên quản lý — Quản lý nhà trọ"
        Width="1366"
        Height="760"
        MinWidth="1050"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="MenuStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="MenuBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="3">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MenuBorder"
                                        Property="Background"
                                        Value="#334155"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Menu bên trái -->
        <Border Background="#1E293B">
            <DockPanel>
                <Border DockPanel.Dock="Top"
                        Background="#0F172A"
                        Padding="16">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36"
                                Height="36"
                                Background="#2563EB"
                                CornerRadius="3">
                            <TextBlock Text="NT"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="QUẢN LÝ NHÀ TRỌ"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="12"/>

                            <TextBlock Text="Hệ thống quản lý"
                                       Foreground="#94A3B8"
                                       FontSize="10"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Button DockPanel.Dock="Bottom"
                        Content="↪  Đăng xuất"
                        Style="{StaticResource MenuStyle}"
                        Foreground="#FCA5A5"
                        Margin="10"
                        Click="Logout_Click"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10,18">
                        <TextBlock Text="TỔNG QUAN"
                                   Foreground="#94A3B8"
                                   FontSize="10"
                                   Margin="8,0,0,8"/>

                        <Button x:Name="btnOverview"
                                Content="Tổng quan"
                                Background="#2563EB"
                                Foreground="White"
                                Style="{StaticResource MenuStyle}"
                                Click="Overview_Click"/>

                        <Separator Background="#334155"
                                   Margin="0,12"/>

                        <TextBlock Text="QUẢN LÝ"
                                   Foreground="#94A3B8"
                                   FontSize="10"
                                   Margin="8,0,0,8"/>

                        <Button x:Name="btnRooms"
                                Content="Phòng trọ"
                                Style="{StaticResource MenuStyle}"
                                Click="Rooms_Click"/>

                        <Button x:Name="btnTenants"
                                Content="Khách thuê"
                                Style="{StaticResource MenuStyle}"
                                Click="Tenants_Click"/>

                        <Button x:Name="btnContracts"
                                Content="Hợp đồng"
                                Style="{StaticResource MenuStyle}"
                                Click="Contracts_Click"/>

                        <Button x:Name="btnInvoices"
                                Content="Hóa đơn"
                                Style="{StaticResource MenuStyle}"
                                Click="Invoices_Click"/>

                        <Button x:Name="btnRepairs"
                                Content="Sửa chữa"
                                Style="{StaticResource MenuStyle}"
                                Click="Repairs_Click"/>

                        <Button x:Name="btnNotifications"
                                Content="Thông báo"
                                Style="{StaticResource MenuStyle}"
                                Click="Notifications_Click"/>

                        <Separator Background="#334155"
                                   Margin="0,12"/>

                        <TextBlock Text="THỐNG KÊ"
                                   Foreground="#94A3B8"
                                   FontSize="10"
                                   Margin="8,0,0,8"/>

                        <Button x:Name="btnReports"
                                Content="Báo cáo"
                                Style="{StaticResource MenuStyle}"
                                Click="Reports_Click"/>

                        <Separator Background="#334155"
                                   Margin="0,12"/>

                        <TextBlock Text="TÀI KHOẢN"
                                   Foreground="#94A3B8"
                                   FontSize="10"
                                   Margin="8,0,0,8"/>

                        <Button x:Name="btnProfile"
                                Content="Hồ sơ cá nhân"
                                Style="{StaticResource MenuStyle}"
                                Click="Profile_Click"/>

                        <Button x:Name="btnPassword"
                                Content="Đổi mật khẩu"
                                Style="{StaticResource MenuStyle}"
                                Click="Password_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Vùng nội dung -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Thanh trên cùng -->
            <Border Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,0,0,1"
                    Padding="22,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="txtBreadcrumb"
                               Text="Hệ thống / Tổng quan"
                               Foreground="#64748B"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"
                               TextTrimming="CharacterEllipsis"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <!-- Chuông thông báo cá nhân -->
                        <Button x:Name="btnThongBaoCaNhan"
                                Width="44"
                                Height="38"
                                Margin="0,0,16,0"
                                Padding="4"
                                Background="White"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                Cursor="Hand"
                                ToolTip="Thông báo gửi đến bạn"
                                Click="ThongBaoCaNhan_Click">

                            <Grid Width="32" Height="28">
                                <TextBlock Text="🔔"
           FontFamily="Segoe UI Emoji"
           FontSize="20"
           HorizontalAlignment="Center"
           VerticalAlignment="Center"/>

                                <Border x:Name="badgeThongBao"
                                        Background="#DC2626"
                                        CornerRadius="8"
                                        MinWidth="16"
                                        Height="16"
                                        Padding="3,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="txtSoThongBao"
                                               Foreground="White"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Thông tin tài khoản -->
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="txtUser"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A"/>

                            <TextBlock Text="Nhân viên quản lý"
                                       Foreground="#64748B"
                                       FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            
            <ContentControl x:Name="contentArea"
                            Grid.Row="1"/>
        </Grid>
    </Grid>
</Window>