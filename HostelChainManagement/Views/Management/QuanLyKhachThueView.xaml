<UserControl x:Class="QuanLyChuoiNhaTro.Views.Management.QuanLyKhachThueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1023.551"
             d:DesignHeight="650"
             Loaded="View_Loaded"
             Background="#F8FAFC">

    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Quản lý khách thuê"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#0F172A"/>

                <TextBlock Text="Quản lý thông tin khách thuê thuộc phạm vi phụ trách."
                           Margin="0,6,0,0"
                           Foreground="#64748B"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Button x:Name="btnThemKhach"
        Grid.Column="1"
        Content="+ Thêm khách thuê"
        VerticalAlignment="Center"
        Click="Them_Click"/>
        </Grid>

        <!-- Tìm kiếm -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="4"
                Padding="16"
                Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Tìm kiếm khách thuê"
                           FontWeight="SemiBold"
                           Foreground="#334155"
                           Margin="0,0,0,8"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <TextBox x:Name="txtTimKiem"
                                 Padding="10,8"
                                 MinHeight="40"
                                 BorderBrush="#CBD5E1"
                                 VerticalContentAlignment="Center"
                                 KeyDown="TimKiem_KeyDown"/>

                        <TextBlock Text="Nhập họ tên, CCCD hoặc SĐT..."
                                   Margin="11,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="#94A3B8"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger
                                            Binding="{Binding Text, ElementName=txtTimKiem}"
                                            Value="">
                                            <Setter Property="Visibility"
                                                    Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Button x:Name="btnTimKiem"
                            Grid.Column="1"
                            Content="Tìm kiếm"
                            Margin="12,0,0,0"
                            Click="TimKiem_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Danh sách -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="16">
                    <TextBlock Text="Danh sách khách thuê"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#334155"/>

                    <TextBlock Text="Khách thuê có hợp đồng trong các dãy trọ được phân công."
                               Margin="0,5,0,0"
                               Foreground="#64748B"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Grid Grid.Row="1">
                    <DataGrid x:Name="dgKhachThue"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0"
                              Background="White"
                              AlternatingRowBackground="#F8FAFC"
                              SelectionChanged="ChonKhach_Changed"
                              BorderThickness="0"
                              RowHeight="42">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Họ tên"
                                                Binding="{Binding HoTen}"
                                                Width="1.5*"/>

                            <DataGridTextColumn Header="CCCD"
                                                Binding="{Binding CCCD}"
                                                Width="*"/>

                            <DataGridTextColumn Header="SĐT"
                                                Binding="{Binding SoDienThoai}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Phòng đang thuê"
                                                Binding="{Binding PhongDangThue}"
                                                Width="1.5*"/>

                            <DataGridTextColumn Header="Trạng thái"
                                                Binding="{Binding TrangThai}"
                                                Width="1.3*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock x:Name="txtDanhSachTrong"
                               Text="Đang tải danh sách khách thuê..."
                               Foreground="#94A3B8"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="16,40,16,0"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               IsHitTestVisible="False"/>
                </Grid>

                <Border Grid.Row="2"
                        BorderBrush="#E2E8F0"
                        BorderThickness="0,1,0,0"
                        Padding="14">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button x:Name="btnXoaKhach"
        Content="Xóa"
        Background="White"
        Foreground="#DC2626"
        BorderBrush="#DC2626"
        BorderThickness="1"
        Margin="0,0,8,0"
        IsEnabled="False"
        Click="Xoa_Click"/>

                        <Button x:Name="btnCapNhat"
        Content="Cập nhật"
        IsEnabled="False"
        Click="CapNhat_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <TextBlock x:Name="txtTrangThai"
                   Grid.Row="3"
                   Margin="0,12,0,0"
                   Foreground="#64748B"
                   TextWrapping="Wrap"/>
    </Grid>
</UserControl>