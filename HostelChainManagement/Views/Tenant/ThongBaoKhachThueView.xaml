<UserControl x:Class="QuanLyChuoiNhaTro.Views.Tenant.ThongBaoKhachThueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1000"
             d:DesignHeight="700"
             Background="#F8FAFC"
             Loaded="View_Loaded">

    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="editorPanel"
          Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề và nút tải lại -->
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Thông báo của bạn"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#0F172A"/>

                <TextBlock
                    Text="Thông báo được gửi đến tài khoản đang đăng nhập."
                    Margin="0,6,0,0"
                    Foreground="#64748B"
                    TextWrapping="Wrap"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="Tải lại"
                    VerticalAlignment="Center"
                    Click="Refresh_Click"/>
        </Grid>

        <!-- Danh sách bên trái, nội dung bên phải -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1.3*"/>
            </Grid.ColumnDefinitions>

            <Border Background="White"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="4">

                <!-- Giữ tên control để tương thích code hiện tại -->
                <ListBox x:Name="notificationsGrid"
                         BorderThickness="0"
                         Background="White"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionChanged="Notification_SelectionChanged">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="0,0,0,1">

                                <StackPanel>
                                    <TextBlock Text="{Binding TieuDe}"
                                               FontSize="14"
                                               TextWrapping="Wrap">

                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight"
                                                        Value="Normal"/>

                                                <Setter Property="Foreground"
                                                        Value="#475569"/>

                                                <Style.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding DaDoc}"
                                                        Value="False">

                                                        <Setter Property="FontWeight"
                                                                Value="Bold"/>

                                                        <Setter Property="Foreground"
                                                                Value="#0F172A"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Text="{Binding NguoiGui}"
                                               Margin="0,6,0,0"
                                               Foreground="#64748B"
                                               TextWrapping="Wrap"/>

                                    <TextBlock
                                        Text="{Binding NgayGui,
                                            StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                        Margin="0,4,0,0"
                                        Foreground="#94A3B8"
                                        FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="16">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="txtTieuDe"
                               Text="Chọn một thông báo"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               TextWrapping="Wrap"/>

                    <TextBlock x:Name="txtThongTin"
                               Grid.Row="1"
                               Margin="0,10,0,16"
                               Foreground="#64748B"
                               TextWrapping="Wrap"/>

                    <TextBox x:Name="txtNotification"
                             Grid.Row="2"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             BorderThickness="0"
                             Background="White"
                             Foreground="#334155"
                             FontSize="13"
                             Padding="0,8,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="txtStatus"
                   Grid.Row="2"
                   Margin="0,12,0,0"
                   Foreground="#64748B"
                   TextWrapping="Wrap"/>
    </Grid>
</UserControl>