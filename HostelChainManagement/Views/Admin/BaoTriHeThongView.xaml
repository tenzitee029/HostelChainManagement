<UserControl x:Class="QuanLyChuoiNhaTro.Views.Admin.BaoTriHeThongView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="viewRoot"
             Background="#F8F9FB">

  <UserControl.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style TargetType="RadioButton">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="TaskBorder"
                    Background="White"
                    BorderBrush="#D1D7E0"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>

            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="TaskBorder"
                        Property="Background"
                        Value="#EFF6FF"/>
                <Setter TargetName="TaskBorder"
                        Property="BorderBrush"
                        Value="#2563EB"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid x:Name="editorPanel">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Width="{Binding ActualWidth, ElementName=viewRoot}"
                  MaxWidth="850"
                  HorizontalAlignment="Left">

        <TextBlock Text="Bảo trì hệ thống"
                   FontSize="22"
                   FontWeight="SemiBold"/>

        <TextBlock Text="Chọn tác vụ bảo trì hệ thống cần thực hiện."
                   Foreground="#7C8798"
                   Margin="0,4,0,12"/>

        <Border Background="White"
                BorderBrush="#D1D7E0"
                BorderThickness="1"
                CornerRadius="3"
                Margin="0,0,0,14">
          <StackPanel>
            <Border Padding="14,11"
                    BorderBrush="#E1E5EC"
                    BorderThickness="0,0,0,1">
              <TextBlock Text="Tác vụ bảo trì"
                         FontWeight="SemiBold"/>
            </Border>

            <UniformGrid Columns="2" Margin="12">
              <RadioButton Content="Sao lưu CSDL (Backup)"
                           Tag="Backup"
                           GroupName="Maintenance"
                           Checked="Task_Checked"
                           Padding="14,22"
                           Margin="5"/>

              <RadioButton Content="Khôi phục CSDL (Restore)"
                           Tag="Restore"
                           GroupName="Maintenance"
                           Checked="Task_Checked"
                           Padding="14,22"
                           Margin="5"/>

              <RadioButton Content="Xem nhật ký hệ thống (System Logs)"
                           Tag="Logs"
                           GroupName="Maintenance"
                           Checked="Task_Checked"
                           Padding="14,22"
                           Margin="5"/>

              <RadioButton Content="Dọn dẹp tệp tạm"
                           Tag="Cache"
                           GroupName="Maintenance"
                           Checked="Task_Checked"
                           Padding="14,22"
                           Margin="5"/>
            </UniformGrid>
          </StackPanel>
        </Border>

        <Border Background="White"
                BorderBrush="#D1D7E0"
                BorderThickness="1"
                CornerRadius="3">
          <StackPanel>
            <Border Padding="14,11"
                    BorderBrush="#E1E5EC"
                    BorderThickness="0,0,0,1">
              <TextBlock Text="Xác nhận thao tác"
                         FontWeight="SemiBold"/>
            </Border>

            <Grid Margin="16,20">
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Tác vụ đã chọn"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>

                <TextBox x:Name="txtTask"
                         Text="—"
                         IsReadOnly="True"
                         Background="#F8F9FB"
                         Padding="10,7"/>
              </StackPanel>

              <Button Grid.Column="1"
                      Content="Xác nhận thực hiện"
                      Background="#2563EB"
                      Foreground="White"
                      VerticalAlignment="Bottom"
                      Click="ExecuteTask_Click"/>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <TextBlock x:Name="txtStatus"
               Grid.Row="1"
               Foreground="#B45309"
               TextWrapping="Wrap"
               Margin="0,12,0,0"/>
  </Grid>
</UserControl>