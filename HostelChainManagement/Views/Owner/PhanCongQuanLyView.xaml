<UserControl x:Class="QuanLyChuoiNhaTro.Views.Owner.PhanCongQuanLyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F9FAFB"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <Style x:Key="GridHeaderStyle"
               TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,11"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style x:Key="GridCellStyle"
               TargetType="DataGridCell">
            <Setter Property="Padding" Value="9,8"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GridRowStyle"
               TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="Background" Value="White"/>

            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                    <Setter Property="Foreground" Value="#111827"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionButtonStyle"
               TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PageButtonStyle"
               TargetType="Button">
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="24,18,24,20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,16">

            <TextBlock Text="Phân công nhân viên quản lý dãy trọ"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#111827"/>

            <TextBlock Text="Xem nhân viên phụ trách từng dãy, phân công mới hoặc điều chuyển."
                       FontSize="11"
                       Foreground="#6B7280"
                       Margin="0,5,0,0"/>

        </StackPanel>

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.08*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="0.92*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="4">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#FAFAFA"
                            BorderBrush="#E5E7EB"
                            BorderThickness="0,0,0,1"
                            Padding="15,12">

                        <StackPanel>

                            <TextBlock Text="Danh sách dãy trọ"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#111827"/>

                            <TextBlock Text="Chọn dãy trọ để xem người phụ trách hoặc phân công nhân sự."
                                       FontSize="10"
                                       Foreground="#6B7280"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0"/>

                        </StackPanel>

                    </Border>

                    <Grid Grid.Row="1">

                        <DataGrid x:Name="dgvDayTro"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E5E7EB"
                                  BorderThickness="0"
                                  RowHeaderWidth="0"
                                  FontSize="11"
                                  Background="White"
                                  ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                                  CellStyle="{StaticResource GridCellStyle}"
                                  RowStyle="{StaticResource GridRowStyle}"
                                  SelectionChanged="DayTro_SelectionChanged">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Dãy trọ"
                                                    Binding="{Binding TenDayTro}"
                                                    Width="1.25*"
                                                    MinWidth="120"/>

                                <DataGridTextColumn Header="Nhân viên quản lý đang phụ trách"
                                                    Binding="{Binding NguoiPhuTrach}"
                                                    Width="1.45*"
                                                    MinWidth="145"/>

                                <DataGridTemplateColumn Header="Chọn"
                                                        Width="65">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <RadioButton HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}, Mode=OneWay}"
                                                         Click="ChonDayTro_Click"/>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>

                            </DataGrid.Columns>

                        </DataGrid>

                        <TextBlock x:Name="txtDayEmpty"
                                   Text="Đang tải danh sách dãy trọ..."
                                   FontSize="11"
                                   Foreground="#9CA3AF"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="15"
                                   IsHitTestVisible="False"/>

                    </Grid>

                </Grid>

            </Border>

            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="4">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#FAFAFA"
                            BorderBrush="#E5E7EB"
                            BorderThickness="0,0,0,1"
                            Padding="15,12">

                        <StackPanel>

                            <TextBlock Text="Nhân viên quản lý"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#111827"/>

                            <TextBlock Text="Mặc định chỉ hiện nhân viên đang phụ trách dãy đã chọn."
                                       FontSize="10"
                                       Foreground="#6B7280"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0"/>

                        </StackPanel>

                    </Border>

                    <StackPanel Grid.Row="1"
                                Margin="12,12,12,12">

                        <TextBlock Text="Hiển thị nhân viên"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"
                                   Margin="0,0,0,5"/>

                        <ComboBox x:Name="cmbBoLoc"
                                  Height="35"
                                  Padding="8,5"
                                  Background="White"
                                  BorderBrush="#CBD5E1"
                                  FontSize="11"
                                  SelectedIndex="0"
                                  SelectionChanged="BoLoc_SelectionChanged">

                            <ComboBoxItem Content="Đang phụ trách dãy này"/>

                            <ComboBoxItem Content="Chưa phân công"/>

                            <ComboBoxItem Content="Dãy khác (điều chuyển)"/>

                        </ComboBox>

                        <TextBlock Text="Tìm theo mã hoặc họ tên"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"
                                   Margin="0,10,0,5"/>

                        <TextBox x:Name="txtTimKiem"
                                 Height="35"
                                 Padding="9,7"
                                 FontSize="11"
                                 Foreground="#111827"
                                 Background="White"
                                 BorderBrush="#CBD5E1"
                                 ToolTip="Nhập mã nhân viên hoặc họ tên cần tìm"
                                 TextChanged="TimKiem_TextChanged"/>

                    </StackPanel>

                    <Grid Grid.Row="2">

                        <DataGrid x:Name="dgvNhanVien"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E5E7EB"
                                  BorderThickness="0"
                                  RowHeaderWidth="0"
                                  FontSize="11"
                                  Background="White"
                                  ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                                  CellStyle="{StaticResource GridCellStyle}"
                                  RowStyle="{StaticResource GridRowStyle}"
                                  SelectionChanged="NhanVien_SelectionChanged">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Mã nhân viên"
                                                    Binding="{Binding MaNhanVien}"
                                                    Width="1.1*"
                                                    MinWidth="100"/>

                                <DataGridTextColumn Header="Họ tên"
                                                    Binding="{Binding HoTenHienThi}"
                                                    Width="1.6*"
                                                    MinWidth="135"/>

                                <DataGridTemplateColumn Header="Chọn"
                                                        Width="65">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <RadioButton HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}, Mode=OneWay}"
                                                         Click="ChonNhanVien_Click"/>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>

                            </DataGrid.Columns>

                        </DataGrid>

                        <TextBlock x:Name="txtNhanVienEmpty"
                                   Text="Chọn một dãy trọ để xem nhân viên quản lý."
                                   FontSize="11"
                                   Foreground="#9CA3AF"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="15"
                                   IsHitTestVisible="False"/>

                    </Grid>

                    <Border Grid.Row="3"
                            Background="#FAFAFA"
                            BorderBrush="#E5E7EB"
                            BorderThickness="0,1,0,0"
                            Padding="12,9">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="txtSoLuong"
                                       Grid.Column="0"
                                       Text="0 nhân viên"
                                       FontSize="10"
                                       Foreground="#6B7280"
                                       VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">

                                <Button x:Name="btnTrangTruoc"
                                        Content="‹"
                                        Style="{StaticResource PageButtonStyle}"
                                        Click="TrangTruoc_Click"
                                        IsEnabled="False"/>

                                <TextBlock x:Name="txtTrang"
                                           Text="1/1"
                                           FontSize="10"
                                           Foreground="#374151"
                                           VerticalAlignment="Center"
                                           Margin="9,0"/>

                                <Button x:Name="btnTrangSau"
                                        Content="›"
                                        Style="{StaticResource PageButtonStyle}"
                                        Click="TrangSau_Click"
                                        IsEnabled="False"/>

                            </StackPanel>

                        </Grid>

                    </Border>

                </Grid>

            </Border>

        </Grid>

        <TextBlock Grid.Row="2"
                   x:Name="txtHuongDan"
                   Text="Hãy chọn một dãy trọ để xem nhân viên quản lý."
                   Foreground="#6B7280"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,13,0,0"/>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">

            <Button x:Name="btnHuyPhanCong"
                    Content="Hủy quyền phân công"
                    Style="{StaticResource ActionButtonStyle}"
                    Background="White"
                    Foreground="#DC2626"
                    BorderBrush="#FECACA"
                    BorderThickness="1"
                    Margin="0,0,10,0"
                    Click="HuyPhanCong_Click"/>

            <Button x:Name="btnLuuPhanCong"
                    Content="Lưu phân công"
                    Style="{StaticResource ActionButtonStyle}"
                    Background="#2563EB"
                    Foreground="White"
                    BorderThickness="0"
                    Click="LuuPhanCong_Click"/>

        </StackPanel>

    </Grid>

</UserControl>
