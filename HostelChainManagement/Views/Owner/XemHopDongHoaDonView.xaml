<UserControl x:Class="QuanLyChuoiNhaTro.Views.Owner.XemHopDongHoaDonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F9FAFB"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <Style x:Key="FilterLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="FilterComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>

        <Style x:Key="TabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="17,13"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="DetailButtonStyle" TargetType="Button">
            <Setter Property="Content" Value="Xem"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#BFDBFE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,12"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="9,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                </Trigger>

                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid Margin="24,18,24,20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">

            <TextBlock Text="Xem hợp đồng, hóa đơn"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#111827"/>

            <TextBlock Text="Tra cứu hợp đồng thuê và hóa đơn hàng tháng của các dãy trọ thuộc quyền quản lý."
                       FontSize="11"
                       Foreground="#6B7280"
                       Margin="0,5,0,0"
                       TextWrapping="Wrap"/>

        </StackPanel>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#D1D5DB"
                BorderThickness="1"
                CornerRadius="4">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        BorderBrush="#E5E7EB"
                        BorderThickness="0,0,0,1">

                    <StackPanel Orientation="Horizontal">

                        <Button x:Name="btnTabHopDong"
                                Content="Hợp đồng thuê"
                                Style="{StaticResource TabButtonStyle}"
                                Foreground="#2563EB"
                                BorderBrush="#2563EB"
                                Click="TabHopDong_Click"/>

                        <Button x:Name="btnTabHoaDon"
                                Content="Hóa đơn hàng tháng"
                                Style="{StaticResource TabButtonStyle}"
                                Click="TabHoaDon_Click"/>

                    </StackPanel>

                </Border>

                <Border Grid.Row="1"
                        Background="#FAFAFA"
                        BorderBrush="#E5E7EB"
                        BorderThickness="0,0,0,1"
                        Padding="15">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Margin="0,0,12,0">

                            <TextBlock Text="Dãy trọ"
                                       Style="{StaticResource FilterLabelStyle}"/>

                            <ComboBox x:Name="cmbDayTro"
                                      Style="{StaticResource FilterComboStyle}"
                                      SelectedIndex="0"
                                      IsEnabled="False">

                                <ComboBoxItem Content="Tất cả dãy trọ"/>

                            </ComboBox>

                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Margin="0,0,12,0">

                            <TextBlock Text="Phòng"
                                       Style="{StaticResource FilterLabelStyle}"/>

                            <ComboBox x:Name="cmbPhong"
                                      Style="{StaticResource FilterComboStyle}"
                                      SelectedIndex="0"
                                      IsEnabled="False">

                                <ComboBoxItem Content="Tất cả phòng"/>

                            </ComboBox>

                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Margin="0,0,12,0">

                            <TextBlock Text="Thời gian"
                                       Style="{StaticResource FilterLabelStyle}"/>

                            <ComboBox x:Name="cmbThoiGian"
                                      Style="{StaticResource FilterComboStyle}"
                                      SelectedIndex="0">

                                <ComboBoxItem Content="Tất cả thời gian"/>
                                <ComboBoxItem Content="Tháng này"/>
                                <ComboBoxItem Content="Tháng trước"/>
                                <ComboBoxItem Content="3 tháng gần đây"/>
                                <ComboBoxItem Content="Năm nay"/>

                            </ComboBox>

                        </StackPanel>

                        <StackPanel Grid.Column="3"
                                    Margin="0,0,12,0">

                            <TextBlock x:Name="txtNhanTrangThai"
                                       Text="Trạng thái hợp đồng"
                                       Style="{StaticResource FilterLabelStyle}"/>

                            <ComboBox x:Name="cmbTrangThai"
                                      Style="{StaticResource FilterComboStyle}"
                                      SelectedIndex="0">

                                <ComboBoxItem Content="Tất cả trạng thái"/>

                            </ComboBox>

                        </StackPanel>

                        <Button Grid.Column="4"
                                x:Name="btnXemKetQua"
                                Content="Xem kết quả"
                                Background="#2563EB"
                                Foreground="White"
                                FontSize="11"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                Padding="15,9"
                                Height="35"
                                VerticalAlignment="Bottom"
                                Cursor="Hand"
                                Click="XemKetQua_Click"/>

                    </Grid>

                </Border>

                <Grid Grid.Row="2">

                    <Grid x:Name="pnlHopDong">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Padding="16,13"
                                BorderBrush="#E5E7EB"
                                BorderThickness="0,0,0,1">

                            <TextBlock Text="Danh sách hợp đồng thuê"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#111827"/>

                        </Border>

                        <Grid Grid.Row="1">

                            <DataGrid x:Name="dgvHopDong"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      HeadersVisibility="Column"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      RowHeaderWidth="0"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E5E7EB"
                                      BorderThickness="0"
                                      Background="White"
                                      FontSize="11"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">

                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="Mã hợp đồng"
                                                        Binding="{Binding MaHopDong}"
                                                        MinWidth="115"
                                                        Width="1.05*"/>

                                    <DataGridTextColumn Header="Khách thuê"
                                                        Binding="{Binding HoTenKhach}"
                                                        MinWidth="145"
                                                        Width="1.3*"/>

                                    <DataGridTextColumn Header="Phòng"
                                                        Binding="{Binding TenPhong}"
                                                        MinWidth="90"
                                                        Width="0.8*"/>

                                    <DataGridTextColumn Header="Dãy trọ"
                                                        Binding="{Binding TenDayTro}"
                                                        MinWidth="130"
                                                        Width="1.2*"/>

                                    <DataGridTextColumn Header="Ngày bắt đầu"
                                                        Binding="{Binding NgayBatDau, StringFormat={}{0:dd/MM/yyyy}}"
                                                        MinWidth="115"
                                                        Width="1*"/>

                                    <DataGridTextColumn Header="Ngày kết thúc"
                                                        Binding="{Binding NgayKetThuc, StringFormat={}{0:dd/MM/yyyy}}"
                                                        MinWidth="115"
                                                        Width="1*"/>

                                    <DataGridTextColumn Header="Giá thuê"
                                                        Binding="{Binding GiaThue, StringFormat={}{0:N0}}"
                                                        MinWidth="100"
                                                        Width="1*"/>

                                    <DataGridTextColumn Header="Trạng thái"
                                                        Binding="{Binding TrangThai}"
                                                        MinWidth="105"
                                                        Width="1*"/>

                                    <DataGridTemplateColumn Header="Thao tác"
                                                            MinWidth="83"
                                                            Width="83">

                                        <DataGridTemplateColumn.CellTemplate>

                                            <DataTemplate>

                                                <Button Style="{StaticResource DetailButtonStyle}"
                                                        HorizontalAlignment="Center"
                                                        Click="XemHopDong_Click"/>

                                            </DataTemplate>

                                        </DataGridTemplateColumn.CellTemplate>

                                    </DataGridTemplateColumn>

                                </DataGrid.Columns>

                            </DataGrid>

                            <TextBlock x:Name="txtEmptyHopDong"
                                       Text="Danh sách hợp đồng sẽ được tải từ SQL Server ở bước tiếp theo."
                                       FontSize="11"
                                       Foreground="#9CA3AF"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Margin="16"/>

                        </Grid>

                    </Grid>

                    <Grid x:Name="pnlHoaDon"
                          Visibility="Collapsed">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Padding="16,13"
                                BorderBrush="#E5E7EB"
                                BorderThickness="0,0,0,1">

                            <TextBlock Text="Danh sách hóa đơn hàng tháng"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#111827"/>

                        </Border>

                        <Grid Grid.Row="1">

                            <DataGrid x:Name="dgvHoaDon"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      HeadersVisibility="Column"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      RowHeaderWidth="0"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E5E7EB"
                                      BorderThickness="0"
                                      Background="White"
                                      FontSize="11"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">

                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="Mã hóa đơn"
                                                        Binding="{Binding MaHoaDon}"
                                                        MinWidth="115"
                                                        Width="1.1*"/>

                                    <DataGridTextColumn Header="Tháng"
                                                        Binding="{Binding KyThanhToan}"
                                                        MinWidth="90"
                                                        Width="0.8*"/>

                                    <DataGridTextColumn Header="Phòng"
                                                        Binding="{Binding TenPhong}"
                                                        MinWidth="90"
                                                        Width="0.8*"/>

                                    <DataGridTextColumn Header="Khách thuê"
                                                        Binding="{Binding HoTenKhach}"
                                                        MinWidth="145"
                                                        Width="1.4*"/>

                                    <DataGridTextColumn Header="Tổng tiền"
                                                        Binding="{Binding TongTien, StringFormat={}{0:N0}}"
                                                        MinWidth="120"
                                                        Width="1*"/>

                                    <DataGridTextColumn Header="Trạng thái"
                                                        Binding="{Binding TrangThai}"
                                                        MinWidth="120"
                                                        Width="1*"/>

                                    <DataGridTemplateColumn Header="Thao tác"
                                                            MinWidth="83"
                                                            Width="83">

                                        <DataGridTemplateColumn.CellTemplate>

                                            <DataTemplate>

                                                <Button Style="{StaticResource DetailButtonStyle}"
                                                        HorizontalAlignment="Center"
                                                        Click="XemHoaDon_Click"/>

                                            </DataTemplate>

                                        </DataGridTemplateColumn.CellTemplate>

                                    </DataGridTemplateColumn>

                                </DataGrid.Columns>

                            </DataGrid>

                            <TextBlock x:Name="txtEmptyHoaDon"
                                       Text="Danh sách hóa đơn sẽ được tải từ SQL Server ở bước tiếp theo."
                                       FontSize="11"
                                       Foreground="#9CA3AF"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Margin="16"/>

                        </Grid>

                    </Grid>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</UserControl>
