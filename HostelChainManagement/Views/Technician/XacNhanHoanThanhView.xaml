<UserControl x:Class="QuanLyChuoiNhaTro.Views.Technician.XacNhanHoanThanhView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1000"
             d:DesignHeight="850"
             x:Name="viewRoot"
             Background="#F8F9FB"
             Loaded="View_Loaded">

    <UserControl.Resources>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="BorderBrush" Value="#D1D7E0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ReadField"
               TargetType="TextBox"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#F8F9FB"/>
            <Setter Property="Foreground" Value="#64748B"/>
        </Style>

        <Style x:Key="Label"
               TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="Card"
               TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D7E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>

        <Style x:Key="CardHeader"
               TargetType="Border">
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="BorderBrush" Value="#E1E5EC"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

    </UserControl.Resources>

    <Grid x:Name="editorPanel"
          Margin="22">

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Grid MaxWidth="950"
                  HorizontalAlignment="Stretch">

                <StackPanel Margin="0,0,12,0">

                    <TextBlock Text="Xác nhận hoàn thành sửa chữa"
                               FontSize="23"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"
                               TextWrapping="Wrap"/>

                    <TextBlock
                        Text="Ghi nhận kết quả và các linh kiện đã sử dụng khi hoàn tất công việc."
                        Foreground="#64748B"
                        Margin="0,6,0,18"
                        TextWrapping="Wrap"/>

                    <!-- Thông tin công việc -->
                    <Border Style="{StaticResource Card}"
                            Margin="0,0,0,16">

                        <StackPanel>
                            <Border Style="{StaticResource CardHeader}">
                                <TextBlock Text="Công việc đang nghiệm thu"
                                           FontWeight="SemiBold"
                                           Foreground="#0F172A"/>
                            </Border>

                            <Grid Margin="16,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Mã yêu cầu"
                                               Style="{StaticResource Label}"/>

                                    <TextBox x:Name="txtCompleteId"
                                             Style="{StaticResource ReadField}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Phòng"
                                               Style="{StaticResource Label}"/>

                                    <TextBox x:Name="txtCompleteRoom"
                                             Style="{StaticResource ReadField}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Biểu mẫu nghiệm thu -->
                    <Border Style="{StaticResource Card}">

                        <StackPanel>
                            <Border Style="{StaticResource CardHeader}">
                                <TextBlock Text="Biểu mẫu nghiệm thu"
                                           FontWeight="SemiBold"
                                           Foreground="#0F172A"/>
                            </Border>

                            <StackPanel x:Name="completionEditor"
                                        Margin="16">

                                <!-- Cách khắc phục -->
                                <TextBlock Text="Ghi chú cách khắc phục"
                                           Style="{StaticResource Label}"/>

                                <TextBox x:Name="txtResolution"
                                         MaxLength="500"
                                         Height="100"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         VerticalContentAlignment="Top"
                                         Margin="0,0,0,20"/>

                                <!-- Nhập một dòng linh kiện -->
                                <TextBlock Text="Linh kiện sử dụng"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#0F172A"
                                           Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Tên linh kiện"
                                                   Style="{StaticResource Label}"/>

                                        <TextBox x:Name="txtMaterialName"
                                                 MaxLength="100"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Số lượng"
                                                   Style="{StaticResource Label}"/>

                                        <TextBox x:Name="txtQuantity"
                                                 Text="1"
                                                 ToolTip="Số lượng lớn hơn 0, tối đa 2 chữ số thập phân"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Đơn giá (VNĐ)"
                                                   Style="{StaticResource Label}"/>

                                        <TextBox x:Name="txtCost"
                                                 Text="0"
                                                 ToolTip="Nhập số nguyên không âm, ví dụ: 50000"/>
                                    </StackPanel>
                                </Grid>

                                <WrapPanel Margin="0,0,0,14">
                                    <Button Content="Thêm linh kiện"
                                            Background="#2563EB"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Margin="0,0,10,6"
                                            Click="AddMaterial_Click"/>

                                    <Button Content="Xóa dòng đã chọn"
                                            Background="White"
                                            Foreground="#DC2626"
                                            BorderBrush="#CBD5E1"
                                            Margin="0,0,0,6"
                                            Click="RemoveMaterial_Click"/>
                                </WrapPanel>

                                <!-- Danh sách nhiều linh kiện -->
                                <DataGrid x:Name="dgMaterials"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserReorderColumns="False"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#E2E8F0"
                                          Background="White"
                                          BorderBrush="#D1D7E0"
                                          BorderThickness="1"
                                          RowHeight="38"
                                          Height="220"
                                          Margin="0,0,0,12"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">

                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                                            Header="Linh kiện"
                                            Binding="{Binding TenVatTu}"
                                            Width="*"
                                            MinWidth="160"/>

                                        <DataGridTextColumn
                                            Header="Số lượng"
                                            Binding="{Binding SoLuong,
                                                StringFormat={}{0:N2}}"
                                            Width="100"/>

                                        <DataGridTextColumn
                                            Header="Đơn giá"
                                            Binding="{Binding DonGia,
                                                StringFormat={}{0:N0}}"
                                            Width="130"/>

                                        <DataGridTextColumn
                                            Header="Thành tiền"
                                            Binding="{Binding ThanhTien,
                                                StringFormat={}{0:N0}}"
                                            Width="140"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Tổng tiền tự cập nhật -->
                                <Border Background="#EFF6FF"
                                        CornerRadius="4"
                                        Padding="14"
                                        Margin="0,0,0,12">

                                    <TextBlock x:Name="txtTotalMaterials"
                                               Text="Tổng tiền linh kiện: 0 VNĐ"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Foreground="#2563EB"
                                               HorizontalAlignment="Right"
                                               TextWrapping="Wrap"/>
                                </Border>

                                <TextBlock
                                    Text="Nhấn Thêm linh kiện để đưa từng dòng vào danh sách. Chi phí trong danh sách sẽ được tính vào hóa đơn của khách thuê."
                                    Foreground="#64748B"
                                    FontSize="12"
                                    TextWrapping="Wrap"
                                    Margin="0,0,0,20"/>

                                <!-- Ảnh nghiệm thu -->
                                <TextBlock Text="Ảnh hiện trường sau khi sửa xong (không bắt buộc)"
                                           Style="{StaticResource Label}"/>

                                <Border BorderBrush="#D1D7E0"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Padding="8">

                                    <DockPanel>
                                        <Button DockPanel.Dock="Left"
                                                Content="Chọn ảnh"
                                                Padding="10,4"
                                                Margin="0,0,10,0"
                                                Click="ChoosePhoto_Click"/>

                                        <TextBlock x:Name="txtPhoto"
                                                   Text="Chưa chọn tệp"
                                                   Foreground="#64748B"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </Border>

                                <TextBlock
                                    Text="Có thể hoàn tất khi không chọn ảnh. Nếu đính kèm: JPG/PNG, tối đa 10 MB."
                                    FontSize="11"
                                    Foreground="#94A3B8"
                                    TextWrapping="Wrap"
                                    Margin="0,6,0,0"/>
                            </StackPanel>

                            <!-- Nút hoàn thành -->
                            <Border BorderBrush="#E1E5EC"
                                    BorderThickness="0,1,0,0"
                                    Padding="14,12">

                                <Button x:Name="btnComplete"
                                        Content="Xác nhận hoàn tất"
                                        Background="#2563EB"
                                        Foreground="White"
                                        BorderThickness="0"
                                        HorizontalAlignment="Right"
                                        Click="Complete_Click"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <TextBlock x:Name="txtStatus"
                   Grid.Row="1"
                   Foreground="#B45309"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0"/>
    </Grid>
</UserControl>