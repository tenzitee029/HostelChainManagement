<UserControl x:Class="QuanLyChuoiNhaTro.Views.Management.XacNhanThanhToanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="View_Loaded"
             Background="#F8FAFC">

    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#475569"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Margin" Value="0,6,0,16"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">
            <TextBlock Text="Xác nhận thanh toán"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#0F172A"/>

            <TextBlock Text="Kiểm tra hóa đơn và ghi nhận số tiền thực nhận từ khách thuê."
                       Margin="0,6,0,20"
                       TextWrapping="Wrap"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Thông tin hóa đơn -->
                <Border Background="White"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        CornerRadius="4">
                    <StackPanel>
                        <Border Padding="18,14"
                                BorderBrush="#E2E8F0"
                                BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock Text="Hóa đơn cần xác nhận"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Thông tin hóa đơn chọn từ danh sách còn nợ."
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="18">
                            <TextBlock Text="Mã hóa đơn"/>
                            <TextBox x:Name="txtMaHoaDon"
                                     IsReadOnly="True"
                                     Background="#F1F5F9"/>

                            <TextBlock Text="Tên khách"/>
                            <TextBox x:Name="txtTenKhach"
                                     IsReadOnly="True"
                                     Background="#F1F5F9"/>

                            <TextBlock Text="Tổng tiền hóa đơn"/>
                            <TextBox x:Name="txtTongTien"
                                     IsReadOnly="True"
                                     Background="#F1F5F9"/>

                            <TextBlock Text="Số tiền còn nợ"/>
                            <TextBox x:Name="txtConNo"
                                     IsReadOnly="True"
                                     Background="#F1F5F9"/>

                            <TextBlock Text="Trạng thái hiện tại"/>
                            <TextBox x:Name="txtTrangThai"
                                     IsReadOnly="True"
                                     Background="#F1F5F9"
                                     Foreground="#B45309"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Thông tin thanh toán -->
                <Border Grid.Column="2"
                        Background="White"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        CornerRadius="4">
                    <StackPanel>
                        <Border Padding="18,14"
                                BorderBrush="#E2E8F0"
                                BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock Text="Phiếu xác nhận thanh toán"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Nhập số tiền thực nhận và phương thức thanh toán."
                                           Margin="0,5,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="pnlThanhToan" Margin="18">
                            <TextBlock Text="Số tiền thực nhận (VNĐ) *"/>
                            <TextBox x:Name="txtSoTien"
                                     ToolTip="Số nguyên dương, không dùng dấu phân cách hàng nghìn"/>

                            <TextBlock Text="Phương thức thanh toán *"
                                       Margin="0,0,0,8"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Background="#EFF6FF"
                                        BorderBrush="#BFDBFE"
                                        BorderThickness="1"
                                        Padding="12">
                                    <RadioButton x:Name="rbTienMat"
                                                 Content="Tiền mặt"
                                                 GroupName="ThanhToan"/>
                                </Border>

                                <Border Grid.Column="2"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1"
                                        Padding="12">
                                    <RadioButton x:Name="rbChuyenKhoan"
                                                 Content="Chuyển khoản"
                                                 GroupName="ThanhToan"/>
                                </Border>
                            </Grid>

                            <TextBlock
                                Text="Chỉ xác nhận khi đã nhận được tiền hoặc kiểm tra giao dịch chuyển khoản thành công."
                                Margin="0,20,0,0"
                                Foreground="#64748B"
                                TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="#EFF6FF"
                    BorderBrush="#BFDBFE"
                    BorderThickness="1"
                    Padding="14"
                    Margin="0,16,0,0">
                <TextBlock
                    Text="Nếu số tiền thực nhận nhỏ hơn số nợ, hệ thống lưu khoản đã thu và giữ hóa đơn ở trạng thái Còn nợ. Khi trả hết, hóa đơn chuyển sang Đã thanh toán."
                    Foreground="#2563EB"
                    TextWrapping="Wrap"/>
            </Border>

            <TextBlock x:Name="txtThongBao"
                       Margin="0,14,0,0"
                       Foreground="#DC2626"
                       TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <Button x:Name="btnQuayLai"
                        Content="Quay lại"
                        Background="#64748B"
                        Click="QuayLai_Click"/>

                <Button x:Name="btnLuu"
                        Content="Xác nhận hoàn tất"
                        IsEnabled="False"
                        Click="Luu_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>