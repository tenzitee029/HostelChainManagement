<UserControl x:Class="QuanLyChuoiNhaTro.Views.Owner.DayTroFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F9FAFB"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <Style x:Key="FormInputStyle" TargetType="TextBox">
            <Setter Property="MinHeight" Value="35"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="FormComboStyle" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="35"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="24,18,24,20">

            <StackPanel Margin="0,0,0,14">

                <TextBlock x:Name="txtTieuDe"
                           Text="Thêm / Cập nhật dãy trọ"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#111827"/>

                <TextBlock Text="Nhập thông tin dãy trọ."
                           FontSize="11"
                           Foreground="#6B7280"
                           Margin="0,5,0,0"/>

            </StackPanel>

            <Border Background="White"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="4">

                <StackPanel>

                    <Border Background="#FAFAFA"
                            BorderBrush="#E5E7EB"
                            BorderThickness="0,0,0,1"
                            Padding="16,12">

                        <TextBlock Text="Thông tin dãy trọ"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"/>

                    </Border>

                    <StackPanel Margin="18,16,18,16">

                        <Grid Margin="0,0,0,14">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="Mã dãy"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox x:Name="txtMaDay"
                                         Text="—"
                                         IsReadOnly="True"
                                         Background="#F9FAFB"
                                         Style="{StaticResource FormInputStyle}"/>

                            </StackPanel>

                            <StackPanel Grid.Column="2">

                                <TextBlock Text="Trạng thái"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <ComboBox x:Name="cmbTrangThai"
                                          Style="{StaticResource FormComboStyle}"
                                          SelectedIndex="0">

                                    <ComboBoxItem Content="Chọn trạng thái"
                                                  IsEnabled="False"/>

                                    <ComboBoxItem Content="Đang hoạt động"/>

                                    <ComboBoxItem Content="Tạm ngưng"/>

                                    <ComboBoxItem Content="Ngừng hoạt động"/>

                                </ComboBox>

                            </StackPanel>

                        </Grid>

                        <StackPanel Margin="0,0,0,14">

                            <TextBlock Text="Tên dãy trọ"
                                       Style="{StaticResource FieldLabelStyle}"/>

                            <TextBox x:Name="txtTenDay"
                                     MaxLength="100"
                                     Style="{StaticResource FormInputStyle}"/>

                        </StackPanel>

                        <StackPanel Margin="0,0,0,14">

                            <TextBlock Text="Địa chỉ chi tiết"
                                       Style="{StaticResource FieldLabelStyle}"/>

                            <TextBox x:Name="txtDiaChi"
                                     MaxLength="255"
                                     Style="{StaticResource FormInputStyle}"/>

                        </StackPanel>

                        <StackPanel Margin="0,0,0,14">

                            <TextBlock Text="Mô tả"
                                       Style="{StaticResource FieldLabelStyle}"/>

                            <TextBox x:Name="txtMoTa"
                                     Style="{StaticResource FormInputStyle}"
                                     Height="72"
                                     MaxLength="500"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto"/>

                        </StackPanel>

                        <StackPanel Margin="0,0,0,14">

                            <TextBlock Text="Quy định dãy"
                                       Style="{StaticResource FieldLabelStyle}"/>

                            <TextBox x:Name="txtQuyDinh"
                                     Style="{StaticResource FormInputStyle}"
                                     Height="72"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto"/>

                        </StackPanel>

                        <Border Background="#FEF3C7"
                                BorderBrush="#FDE68A"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="13,11">

                            <TextBlock Text="Khi cập nhật trạng thái “Ngừng hoạt động”, hệ thống chỉ cập nhật nếu tất cả phòng trong dãy đều không còn hợp đồng hiệu lực."
                                       FontSize="11"
                                       Foreground="#92400E"
                                       TextWrapping="Wrap"/>

                        </Border>

                        <TextBlock x:Name="txtThongBao"
                                   Text=""
                                   FontSize="11"
                                   Foreground="#DC2626"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"
                                   Visibility="Collapsed"/>

                    </StackPanel>

                    <Border Background="#FAFAFA"
                            BorderBrush="#E5E7EB"
                            BorderThickness="0,1,0,0"
                            Padding="16,12">

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">

                            <Button x:Name="btnLuu"
                                    Content="Lưu"
                                    MinWidth="110"
                                    Height="36"
                                    Background="#2563EB"
                                    Foreground="White"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="Luu_Click"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>
