<UserControl x:Class="QuanLyChuoiNhaTro.Views.Account.DoiMatKhauView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1000"
             d:DesignHeight="700"
             Background="#F8FAFC">

    <UserControl.Resources>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="MaxLength" Value="255"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="MaxLength" Value="255"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,9"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22">
            <TextBlock Text="Đổi mật khẩu"
                       FontSize="23"
                       FontWeight="Bold"/>

            <TextBlock Text="Mật khẩu mới từ 8–255 ký tự, gồm chữ hoa, chữ thường và số."
                       Foreground="#64748B"
                       TextWrapping="Wrap"
                       Margin="0,6,0,16"/>

            <TextBlock x:Name="txtStatus"
                       Foreground="#B45309"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>

            <Border Background="White"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="24"
                    MaxWidth="560"
                    HorizontalAlignment="Left">

                <StackPanel x:Name="editorPanel"
                            MinWidth="360">

                    <TextBlock Text="Mật khẩu hiện tại"/>

                    <Grid Margin="0,6,0,16">
                        <PasswordBox x:Name="pwdCurrent"/>

                        <TextBox x:Name="txtCurrent"
                                 Visibility="Collapsed"/>
                    </Grid>

                    <TextBlock Text="Mật khẩu mới"/>

                    <Grid Margin="0,6,0,16">
                        <PasswordBox x:Name="pwdNew"/>

                        <TextBox x:Name="txtNew"
                                 Visibility="Collapsed"/>
                    </Grid>

                    <TextBlock Text="Xác nhận mật khẩu mới"/>

                    <Grid Margin="0,6,0,16">
                        <PasswordBox x:Name="pwdConfirm"/>

                        <TextBox x:Name="txtConfirm"
                                 Visibility="Collapsed"/>
                    </Grid>

                    <CheckBox x:Name="chkShow"
                              Content="Hiện mật khẩu"
                              Margin="0,0,0,18"
                              Checked="TogglePassword"
                              Unchecked="TogglePassword"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button Content="Xóa nội dung"
                                Click="Clear_Click"
                                Margin="0,0,10,0"/>

                        <Button Content="Lưu thay đổi"
                                Background="#2563EB"
                                Foreground="White"
                                Click="Save_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>