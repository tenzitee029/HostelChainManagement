<Window x:Class="QuanLyChuoiNhaTro.Views.Tenant.PhongCuaToiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Khách thuê — Phòng của tôi"
        Width="1200" Height="720"
        MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,8,12,0"/>
            <Setter Property="Text" Value="—"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E5E7EB"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="36"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Menu riêng của Khách thuê -->
        <Border Background="#1E293B">
            <DockPanel>
                <Border DockPanel.Dock="Top"
                        Background="#0F172A" Padding="16">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#2563EB"
                                Width="36" Height="36" CornerRadius="3">
                            <TextBlock Text="NT" Foreground="White"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="QUẢN LÝ NHÀ TRỌ"
                                       Foreground="White"
                                       FontWeight="Bold" FontSize="12"/>
                            <TextBlock Text="Hệ thống quản lý"
                                       Foreground="#94A3B8" FontSize="10"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Button DockPanel.Dock="Bottom"
                        Content="↪  Đăng xuất"
                        Style="{StaticResource MenuButton}"
                        Foreground="#FCA5A5"
                        Margin="10"
                        Click="Logout_Click"/>

                <StackPanel Margin="10,18">
                    <TextBlock Text="THUÊ TRỌ"
                               Foreground="#94A3B8" FontSize="10"
                               Margin="8,0,0,8"/>

                    <Button Content="Phòng của tôi"
                            Background="#2563EB" Foreground="White"
                            Style="{StaticResource MenuButton}"
                            Click="Refresh_Click"/>

                    <Button Content="Hợp đồng thuê"
                            Style="{StaticResource MenuButton}"
                            Click="PendingFeature_Click"/>

                    <Button Content="Hóa đơn &amp; Chi phí"
                            Style="{StaticResource MenuButton}"
                            Click="PendingFeature_Click"/>

                    <Separator Background="#334155" Margin="0,12"/>

                    <TextBlock Text="YÊU CẦU"
                               Foreground="#94A3B8" FontSize="10"
                               Margin="8,0,0,8"/>

                    <Button Content="Sửa chữa / bảo trì"
                            Style="{StaticResource MenuButton}"
                            Click="PendingFeature_Click"/>

                    <Button Content="Yêu cầu trả phòng"
                            Style="{StaticResource MenuButton}"
                            Click="PendingFeature_Click"/>

                    <Separator Background="#334155" Margin="0,12"/>

                    <TextBlock Text="TÀI KHOẢN"
                               Foreground="#94A3B8" FontSize="10"
                               Margin="8,0,0,8"/>

                    <Button Content="Hồ sơ cá nhân"
                            Style="{StaticResource MenuButton}"
                            Click="PendingFeature_Click"/>

                    <Button Content="Đổi mật khẩu"
                            Style="{StaticResource MenuButton}"
                            Click="PendingFeature_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,0,0,1" Padding="22,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="txtUser"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Khách thuê"
                                   Foreground="#64748B" FontSize="11"/>
                    </StackPanel>

                    <TextBlock Text="Hệ thống / Phòng của tôi"
                               Foreground="#64748B"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="22">
                    <TextBlock Text="Phòng của tôi"
                               FontSize="23" FontWeight="Bold"/>

                    <TextBlock Text="Thông tin phòng trọ đang thuê."
                               Foreground="#64748B" Margin="0,6,0,10"/>

                    <TextBlock x:Name="txtStatus"
                               TextWrapping="Wrap"
                               Foreground="#B45309" Margin="0,0,0,10"/>

                    <Border Style="{StaticResource Card}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Thông tin phòng"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,18"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Số phòng"/>
                                    <TextBox x:Name="txtSoPhong"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Tên dãy trọ"/>
                                    <TextBox x:Name="txtTenDay"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Địa chỉ dãy"/>
                                    <TextBox x:Name="txtDiaChi"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="Diện tích"/>
                                    <TextBox x:Name="txtDienTich"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Width="210"
                                        HorizontalAlignment="Left"
                                        Margin="0,18,0,0">
                                <TextBlock Text="Giá thuê hàng tháng"/>
                                <TextBox x:Name="txtGiaThue"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Card}"
                                Margin="0,0,12,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="300"/>
                                </Grid.RowDefinitions>

                                <StackPanel Margin="14">
                                    <TextBlock Text="Trang thiết bị trong phòng"
                                               FontWeight="SemiBold"/>
                                    <TextBlock
                                        Text="Danh sách thiết bị và tình trạng."
                                        Foreground="#64748B" FontSize="11"
                                        Margin="0,4,0,0"/>
                                </StackPanel>

                                <DataGrid x:Name="dgThietBi" Grid.Row="1">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Tên thiết bị"
                                            Binding="{Binding TenThietBi}" Width="*"/>
                                        <DataGridTextColumn Header="Số lượng"
                                            Binding="{Binding SoLuong}" Width="65"/>
                                        <DataGridTextColumn Header="Tình trạng"
                                            Binding="{Binding TinhTrang}" Width="90"/>
                                        <DataGridTextColumn Header="Ghi chú"
                                            Binding="{Binding GhiChu}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock x:Name="txtEmptyEquipment"
                                           Grid.Row="1"
                                           Text="Chưa có dữ liệu trang thiết bị."
                                           Foreground="#94A3B8" FontSize="11"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1"
                                Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="300"/>
                                </Grid.RowDefinitions>

                                <StackPanel Margin="14">
                                    <TextBlock Text="Thành viên cùng phòng"
                                               FontWeight="SemiBold"/>
                                    <TextBlock
                                        Text="Danh sách thành viên đang ở cùng phòng."
                                        Foreground="#64748B" FontSize="11"
                                        Margin="0,4,0,0"/>
                                </StackPanel>

                                <DataGrid x:Name="dgThanhVien" Grid.Row="1">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Họ tên"
                                            Binding="{Binding HoTen}" Width="*"/>
                                        <DataGridTextColumn Header="Số điện thoại"
                                            Binding="{Binding SoDienThoai}" Width="110"/>
                                        <DataGridTextColumn Header="Quan hệ"
                                            Binding="{Binding QuanHe}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock x:Name="txtEmptyMembers"
                                           Grid.Row="1"
                                           Text="Chưa có dữ liệu thành viên cùng phòng."
                                           Foreground="#94A3B8" FontSize="11"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>