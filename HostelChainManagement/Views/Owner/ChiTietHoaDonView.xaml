<UserControl x:Class="QuanLyChuoiNhaTro.Views.Owner.ChiTietHoaDonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F9FAFB"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <Style x:Key="FieldLabelStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="ReadOnlyFieldStyle"
               TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,11"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="9,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="43"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="24,18,24,20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Chi tiết hóa đơn"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#111827"/>

                <TextBlock Text="Thông tin thanh toán và các khoản thu của hóa đơn."
                           FontSize="11"
                           Foreground="#6B7280"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <Button Content="← Quay lại"
                        Height="36"
                        MinWidth="100"
                        Padding="13,7"
                        Background="White"
                        Foreground="#374151"
                        FontSize="11"
                        FontWeight="SemiBold"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="QuayLai_Click"
                        Margin="0,0,10,0"/>

                <Button x:Name="btnTaiPdf"
                        Content="Tải PDF"
                        Height="36"
                        MinWidth="110"
                        Padding="13,7"
                        Background="#2563EB"
                        Foreground="White"
                        FontSize="11"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        IsEnabled="False"
                        Cursor="Hand"
                        Margin="0,0,10,0"
                        Click="TaiPdf_Click"
                        ToolTip="Lưu hóa đơn đang xem thành tệp PDF"/>

                <Button x:Name="btnInHoaDon"
                        Content="In hóa đơn"
                        Height="36"
                        MinWidth="110"
                        Padding="13,7"
                        Background="White"
                        Foreground="#2563EB"
                        FontSize="11"
                        FontWeight="SemiBold"
                        BorderBrush="#2563EB"
                        BorderThickness="1"
                        IsEnabled="False"
                        Cursor="Hand"
                        Click="InHoaDon_Click"
                        ToolTip="Chọn máy in để in hóa đơn đang xem"/>

            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel>

                <Border Background="White"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="0,0,0,14">

                    <StackPanel>

                        <Border Background="#FAFAFA"
                                BorderBrush="#E5E7EB"
                                BorderThickness="0,0,0,1"
                                Padding="16,12">

                            <TextBlock Text="Thông tin hóa đơn"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#111827"/>
                        </Border>

                        <Grid Margin="18,16,18,18">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0,0,0,13">
                                <TextBlock Text="Mã hóa đơn"
                                           Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="txtMaHoaDon"
                                         Text="—"
                                         Style="{StaticResource ReadOnlyFieldStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0"
                                        Grid.Column="2"
                                        Margin="0,0,0,13">
                                <TextBlock Text="Trạng thái thanh toán"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <Border Background="#F9FAFB"
                                        BorderBrush="#D1D5DB"
                                        BorderThickness="1"
                                        Height="36"
                                        Padding="10,7">

                                    <TextBlock x:Name="txtTrangThai"
                                               Text="—"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#6B7280"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="0,0,0,13">
                                <TextBlock Text="Khách thuê"
                                           Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="txtKhachThue"
                                         Text="—"
                                         Style="{StaticResource ReadOnlyFieldStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1"
                                        Grid.Column="2"
                                        Margin="0,0,0,13">
                                <TextBlock Text="Phòng"
                                           Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="txtPhong"
                                         Text="—"
                                         Style="{StaticResource ReadOnlyFieldStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2"
                                        Grid.Column="0"
                                        Margin="0,0,0,13">
                                <TextBlock Text="Dãy trọ"
                                           Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="txtDayTro"
                                         Text="—"
                                         Style="{StaticResource ReadOnlyFieldStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2"
                                        Grid.Column="2"
                                        Margin="0,0,0,13">
                                <TextBlock Text="Kỳ thanh toán"
                                           Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="txtKyThanhToan"
                                         Text="—"
                                         Style="{StaticResource ReadOnlyFieldStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3"
                                        Grid.Column="0"
                                        Margin="0,0,0,13">
                                <TextBlock Text="Mã hợp đồng"
                                           Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="txtMaHopDong"
                                         Text="—"
                                         Style="{StaticResource ReadOnlyFieldStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3"
                                        Grid.Column="2"
                                        Margin="0,0,0,13">
                                <TextBlock Text="Ngày lập hóa đơn"
                                           Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="txtNgayLap"
                                         Text="—"
                                         Style="{StaticResource ReadOnlyFieldStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="4"
                                        Grid.Column="0">
                                <TextBlock Text="Hạn thanh toán"
                                           Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="txtHanThanhToan"
                                         Text="—"
                                         Style="{StaticResource ReadOnlyFieldStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="4"
                                        Grid.Column="2">
                                <TextBlock Text="Phương thức thanh toán"
                                           Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="txtPhuongThuc"
                                         Text="—"
                                         Style="{StaticResource ReadOnlyFieldStyle}"/>
                            </StackPanel>

                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="White"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        CornerRadius="4">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="#FAFAFA"
                                BorderBrush="#E5E7EB"
                                BorderThickness="0,0,0,1"
                                Padding="16,12">

                            <TextBlock Text="Chi tiết các khoản thu"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#111827"/>
                        </Border>

                        <Grid Grid.Row="1">

                            <DataGrid x:Name="dgvKhoanThu"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      HeadersVisibility="Column"
                                      RowHeaderWidth="0"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E5E7EB"
                                      BorderThickness="0"
                                      Background="White"
                                      FontSize="11"
                                      Height="220"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">

                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="Khoản thu"
                                                        Binding="{Binding LoaiKhoanThu}"
                                                        MinWidth="110"
                                                        Width="1.3*"/>

                                    <DataGridTextColumn Header="Chỉ số cũ"
                                                        Binding="{Binding ChiSoCu, StringFormat={}{0:N2}}"
                                                        MinWidth="85"
                                                        Width="0.8*"/>

                                    <DataGridTextColumn Header="Chỉ số mới"
                                                        Binding="{Binding ChiSoMoi, StringFormat={}{0:N2}}"
                                                        MinWidth="85"
                                                        Width="0.8*"/>

                                    <DataGridTextColumn Header="Số lượng"
                                                        Binding="{Binding SoLuong, StringFormat={}{0:N2}}"
                                                        MinWidth="85"
                                                        Width="0.8*"/>

                                    <DataGridTextColumn Header="Đơn giá"
                                                        Binding="{Binding DonGia, StringFormat={}{0:N0}}"
                                                        MinWidth="105"
                                                        Width="1*"/>

                                    <DataGridTextColumn Header="Thành tiền"
                                                        Binding="{Binding ThanhTien, StringFormat={}{0:N0}}"
                                                        MinWidth="120"
                                                        Width="1.1*"/>

                                    <DataGridTextColumn Header="Ghi chú"
                                                        Binding="{Binding GhiChu}"
                                                        MinWidth="125"
                                                        Width="1.2*"/>

                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock x:Name="txtEmptyKhoanThu"
                                       Text="Đang tải các khoản thu..."
                                       FontSize="11"
                                       Foreground="#9CA3AF"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="12"
                                       IsHitTestVisible="False"/>
                        </Grid>

                        <Border Grid.Row="2"
                                Background="#FAFAFA"
                                BorderBrush="#E5E7EB"
                                BorderThickness="0,1,0,0"
                                Padding="16,13">

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">

                                <TextBlock Text="Tổng tiền:"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#374151"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>

                                <TextBlock x:Name="txtTongTien"
                                           Text="—"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#2563EB"
                                           VerticalAlignment="Center"/>

                            </StackPanel>
                        </Border>

                    </Grid>
                </Border>

                <TextBlock x:Name="txtThongBao"
                           Text="Đang tải chi tiết hóa đơn..."
                           Foreground="#6B7280"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>