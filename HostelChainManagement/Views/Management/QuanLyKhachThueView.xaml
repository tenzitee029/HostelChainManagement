<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="QuanLyChuoiNhaTro.Views.Management.QuanLyKhachThueView"
             Loaded="View_Loaded"
             Background="#F8FAFC"
             FontFamily="Segoe UI" d:DesignHeight="762.517" d:DesignWidth="1183.624">

    <UserControl.Resources>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Quản lý khách thuê"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#0F172A"/>

                <TextBlock Text="Danh sách người đứng tên hợp đồng và thành viên ở cùng."
                           Margin="0,6,0,0"
                           Foreground="#64748B"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Button x:Name="btnThemKhach"
                    Grid.Column="1"
                    Content="+ Thêm khách thuê"
                    VerticalAlignment="Center"
                    Click="Them_Click"/>
        </Grid>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtTimKiem"
                         Padding="10,8"
                         BorderBrush="#CBD5E1"
                         VerticalContentAlignment="Center"
                         ToolTip="Tìm theo họ tên, CCCD, số điện thoại hoặc phòng"
                         KeyDown="TimKiem_KeyDown"/>

                <Button x:Name="btnTimKiem"
                        Grid.Column="1"
                        Content="Tìm kiếm"
                        Click="TimKiem_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Danh sách khách thuê"
                           Margin="16"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#0F172A"/>

                <Grid Grid.Row="1">
                    <DataGrid x:Name="dgKhachThue"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0"
                              BorderThickness="0"
                              RowHeight="42"
                              Background="White"
                              AlternatingRowBackground="#F8FAFC"
                              SelectionChanged="ChonKhach_Changed">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã hồ sơ"
                                                Binding="{Binding MaKhachThue}"
                                                Width="140"/>
                            <DataGridTextColumn Header="Họ tên"
                                                Binding="{Binding HoTen}"
                                                Width="1.3*"/>
                            <DataGridTextColumn Header="CCCD"
                                                Binding="{Binding CCCD}"
                                                Width="110"/>
                            <DataGridTextColumn Header="Điện thoại"
                                                Binding="{Binding SoDienThoai}"
                                                Width="100"/>
                            <DataGridTextColumn Header="Phòng ở"
                                                Binding="{Binding PhongDangThue}"
                                                Width="1.3*"/>
                            <DataGridTextColumn Header="Vai trò"
                                                Binding="{Binding LoaiHoSo}"
                                                Width="1.2*"/>
                            <DataGridTextColumn Header="Trạng thái"
                                                Binding="{Binding TrangThai}"
                                                Width="1.3*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock x:Name="txtDanhSachTrong"
                               Text="Đang tải dữ liệu..."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#64748B"
                               TextWrapping="Wrap"
                               Margin="20"
                               IsHitTestVisible="False"/>
                </Grid>

                <Border Grid.Row="2"
                        BorderBrush="#E2E8F0"
                        BorderThickness="0,1,0,0"
                        Padding="16">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button x:Name="btnXoaKhach"
                                Content="Xóa"
                                Background="#DC2626"
                                IsEnabled="False"
                                Click="Xoa_Click"/>

                        <Button x:Name="btnCapNhat"
                                Content="Cập nhật"
                                IsEnabled="False"
                                Click="CapNhat_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <TextBlock x:Name="txtTrangThai"
                   Grid.Row="3"
                   Margin="0,12,0,0"
                   Foreground="#64748B"
                   TextWrapping="Wrap"/>
    </Grid>
</UserControl>