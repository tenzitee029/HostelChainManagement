<UserControl x:Class="QuanLyChuoiNhaTro.Views.Management.KhachThueFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="View_Loaded"
             Background="#F8FAFC">

    <UserControl.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Margin" Value="0,6,0,16"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Margin" Value="0,6,0,16"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#475569"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled" Width="1088">
        <StackPanel Margin="24">
            <TextBlock x:Name="txtTieuDe"
                       Text="Thêm khách thuê"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#0F172A"/>

            <TextBlock Text="Quản lý hồ sơ khách thuê thuộc dãy trọ được phân công."
                       Margin="0,6,0,20"
                       TextWrapping="Wrap"/>

            <Border Background="White"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="4">
                <StackPanel>
                    <Border Padding="18,14"
                            BorderBrush="#E2E8F0"
                            BorderThickness="0,0,0,1">
                        <TextBlock Text="Thông tin khách thuê"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>
                    </Border>

                    <StackPanel x:Name="pnlThongTin" Margin="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="Mã khách"/>
                                <TextBox x:Name="txtMaKhach"
                                         IsReadOnly="True"
                                         Background="#F8FAFC"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Họ tên *"/>
                                <TextBox x:Name="txtHoTen"
                                         MaxLength="100"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1">
                                <TextBlock Text="CCCD *"/>
                                <TextBox x:Name="txtCCCD"
                                         MaxLength="12"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Text="Số điện thoại *"/>
                                <TextBox x:Name="txtSoDienThoai"
                                         MaxLength="10"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Địa chỉ thường trú *"/>
                        <TextBox x:Name="txtDiaChi"
                                 MaxLength="255"
                                 Height="70"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"/>

                        <TextBlock Text="Dãy quản lý hồ sơ *"/>
                        <ComboBox x:Name="cboDayTro"
                                  DisplayMemberPath="TenDayTro"
                                  SelectedValuePath="MaDayTro"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Phòng ở"/>
                                <ComboBox x:Name="cboPhong"
                                          IsEnabled="False"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Vai trò trong phòng"/>
                                <ComboBox x:Name="cboVaiTro"
                                          IsEnabled="False"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Text="Trạng thái"/>
                                <TextBox x:Name="txtTrangThai"
                                         Text="Chưa có hợp đồng"
                                         IsReadOnly="True"
                                         Background="#F8FAFC"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock
                            Text="Phòng ở và trạng thái được xác định từ hợp đồng. Khách mới được tạo tài khoản tự động. Lập hợp đồng và chuyển phòng tại mục Hợp đồng."
                            Foreground="#64748B"
                            TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBlock x:Name="txtThongBao"
                               Margin="18,0,18,16"
                               Foreground="#DC2626"
                               TextWrapping="Wrap"/>

                    <Border BorderBrush="#E2E8F0"
                            BorderThickness="0,1,0,0"
                            Padding="16">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button x:Name="btnQuayLai"
                                    Content="Quay lại"
                                    Background="#64748B"
                                    Click="QuayLai_Click"/>

                            <Button x:Name="btnLuu"
                                    Content="Lưu hồ sơ"
                                    IsEnabled="False"
                                    Click="Luu_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>