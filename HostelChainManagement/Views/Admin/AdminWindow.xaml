<Window x:Class="QuanLyChuoiNhaTro.Views.Admin.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin hệ thống — Quản lý nhà trọ"
        Width="1200"
        Height="760"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FB"
        FontFamily="Segoe UI"
        Foreground="#182132">

  <Window.Resources>
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Foreground" Value="#CBD5E1"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="Margin" Value="8,3"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder"
                    Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}"
                    CornerRadius="3">
              <ContentPresenter
                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalAlignment="Center"/>
            </Border>

            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder"
                        Property="Opacity"
                        Value="0.85"/>
              </Trigger>

              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonBorder"
                        Property="Opacity"
                        Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="HeaderButton" TargetType="Button">
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#475569"/>
      <Setter Property="BorderBrush" Value="#E1E5EC"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="192"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Menu bên trái -->
    <Border Grid.Column="0" Background="#1E293B">
      <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top"
                Height="60"
                Background="#0F172A"
                Padding="15,10">
          <StackPanel Orientation="Horizontal">
            <Border Width="34"
                    Height="34"
                    Background="#2563EB"
                    CornerRadius="3">
              <TextBlock Text="NT"
                         Foreground="White"
                         FontWeight="Bold"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
            </Border>

            <StackPanel Margin="9,0,0,0"
                        VerticalAlignment="Center">
              <TextBlock Text="QUẢN LÝ NHÀ TRỌ"
                         Foreground="White"
                         FontSize="11"
                         FontWeight="Bold"/>

              <TextBlock Text="Hệ thống quản lý"
                         Foreground="#94A3B8"
                         FontSize="9"
                         Margin="0,3,0,0"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                BorderBrush="#334155"
                BorderThickness="0,1,0,0"
                Padding="0,10">
          <Button Content="Đăng xuất"
                  Foreground="#FCA5A5"
                  Style="{StaticResource NavButton}"
                  Click="Logout_Click"/>
        </Border>

        <StackPanel x:Name="navPanel"
                    Margin="0,18,0,0">
          <TextBlock Text="HỆ THỐNG"
                     Foreground="#94A3B8"
                     FontSize="9"
                     FontWeight="SemiBold"
                     Margin="17,0,0,5"/>

          <Button x:Name="btnMaintenance"
                  Content="Bảo trì hệ thống"
                  Style="{StaticResource NavButton}"
                  Click="Maintenance_Click"/>

          <Button x:Name="btnAccounts"
                  Content="Quản lý tài khoản"
                  Style="{StaticResource NavButton}"
                  Click="Accounts_Click"/>

          <Border Height="1"
                  Background="#334155"
                  Margin="8,12"/>

          <TextBlock Text="TÀI KHOẢN"
                     Foreground="#94A3B8"
                     FontSize="9"
                     FontWeight="SemiBold"
                     Margin="17,0,0,5"/>

          <Button x:Name="btnProfile"
                  Content="Hồ sơ cá nhân"
                  Style="{StaticResource NavButton}"
                  Click="Profile_Click"/>

          <Button x:Name="btnPassword"
                  Content="Đổi mật khẩu"
                  Style="{StaticResource NavButton}"
                  Click="Password_Click"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="60"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Thanh đầu trang -->
      <Border Grid.Row="0"
              Background="White"
              BorderBrush="#E1E5EC"
              BorderThickness="0,0,0,1"
              Padding="20,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <TextBlock x:Name="txtBreadcrumb"
                     Grid.Column="0"
                     Foreground="#64748B"
                     FontSize="11"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     Margin="0,0,15,0"/>

          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      VerticalAlignment="Center">
            <Button x:Name="btnBell"
                    Content="Thông báo"
                    Style="{StaticResource HeaderButton}"
                    Click="Bell_Click"
                    Margin="0,0,12,0"/>

            <Border Width="30"
                    Height="30"
                    Background="#DBEAFE"
                    CornerRadius="15"
                    Margin="0,0,8,0">
              <TextBlock Text="AD"
                         Foreground="#2563EB"
                         FontSize="11"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
            </Border>

            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="txtUser"
                         FontSize="11"
                         FontWeight="SemiBold"/>

              <TextBlock Text="Quản trị hệ thống"
                         FontSize="9"
                         Foreground="#94A3B8"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Vùng hiển thị UserControl -->
      <ContentControl x:Name="contentArea"
                      Grid.Row="1"
                      Margin="20,18,20,20"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch"/>
    </Grid>
  </Grid>
</Window>