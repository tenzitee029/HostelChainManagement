<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="QuanLyChuoiNhaTro.Views.Management.ChiTietYeuCauView"
             Loaded="View_Loaded"
             Background="#F8FAFC" d:DesignWidth="1062.075">

    <UserControl.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#475569"/>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Margin" Value="0,6,0,16"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>

        <Style x:Key="ChiXem" TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#F1F5F9"/>
        </Style>

        <Style TargetType="{x:Type Button}">
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Chi tiết yêu cầu sửa chữa"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#0F172A"/>
                    <TextBlock Text="Kiểm tra thông tin sự cố do người gửi cung cấp."
                               Margin="0,6,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#F1F5F9"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        Padding="12,6"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="txtTrangThai"
                               Text="Đang tải..."
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.7*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Thông tin yêu cầu -->
                <Border Background="White"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        CornerRadius="4">
                    <StackPanel>
                        <Border Padding="18,14"
                                BorderBrush="#E2E8F0"
                                BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock Text="Phiếu yêu cầu sửa chữa"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Thông tin yêu cầu do người gửi cung cấp."
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Mã yêu cầu"/>
                                    <TextBox x:Name="txtMaYeuCau"
                                             Style="{StaticResource ChiXem}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Ngày gửi"/>
                                    <TextBox x:Name="txtNgayGui"
                                             Style="{StaticResource ChiXem}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1">
                                    <TextBlock Text="Người gửi"/>
                                    <TextBox x:Name="txtNguoiGui"
                                             Style="{StaticResource ChiXem}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="2">
                                    <TextBlock Text="Phòng"/>
                                    <TextBox x:Name="txtPhong"
                                             Style="{StaticResource ChiXem}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Nội dung mô tả sự cố"/>
                            <TextBox x:Name="txtNoiDung"
                                     Style="{StaticResource ChiXem}"
                                     MinHeight="130"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"/>

                            <TextBlock x:Name="txtThongTinThem"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Tệp đính kèm -->
                <Border Grid.Column="2"
                        Background="White"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        CornerRadius="4">
                    <StackPanel>
                        <Border Padding="18,14"
                                BorderBrush="#E2E8F0"
                                BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock Text="Hình ảnh / Video đính kèm"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Tệp do người gửi cung cấp."
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Margin="16"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                MinHeight="230">
                            <Grid>
                                <Image x:Name="imgDinhKem"
                                       Height="230"
                                       Stretch="Uniform"
                                       Visibility="Collapsed"/>

                                <TextBlock x:Name="txtKhongCoTep"
                                           Text="Không có tệp đính kèm."
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="12"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"/>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="txtDuongDan"
                                   Margin="16,0,16,12"
                                   Foreground="#64748B"
                                   TextWrapping="Wrap"/>

                        <Button x:Name="btnMoTep"
                                Content="Mở tệp đính kèm"
                                Margin="16,0,16,16"
                                IsEnabled="False"
                                Click="MoTep_Click"/>
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel x:Name="pnlLyDo"
                        Visibility="Collapsed"
                        Margin="0,16,0,0">
                <TextBlock Text="Lý do từ chối *"/>
                <TextBox x:Name="txtLyDo"
                         MaxLength="255"
                         Height="75"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"/>
            </StackPanel>

            <TextBlock x:Name="txtThongBao"
                       Margin="0,14,0,0"
                       Foreground="#DC2626"
                       TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <Button x:Name="btnQuayLai"
                        Content="Quay lại"
                        Background="#64748B"
                        Click="QuayLai_Click"/>

                <Button x:Name="btnTuChoi"
                        Content="Từ chối tiếp nhận"
                        Background="White"
                        Foreground="#DC2626"
                        BorderBrush="#DC2626"
                        BorderThickness="1"
                        IsEnabled="False"
                        Click="TuChoi_Click"/>

                <Button x:Name="btnTiepNhan"
        Content="Tiếp nhận yêu cầu"
        IsEnabled="False"
        Click="TiepNhan_Click"/>

            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>