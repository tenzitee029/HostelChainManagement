<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="QuanLyChuoiNhaTro.Views.Management.PhanCongKyThuatView"
             Loaded="View_Loaded"
             Background="#F8FAFC" d:DesignWidth="1032.748">

    <UserControl.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#475569"/>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Margin" Value="0,6,0,16"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>

        <Style TargetType="{x:Type Button}">
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Phân công nhân viên kỹ thuật"
                               FontSize="24" FontWeight="Bold"
                               Foreground="#0F172A"/>
                    <TextBlock Text="Chọn nhân viên kỹ thuật phụ trách xử lý yêu cầu sửa chữa."
                               Margin="0,6,0,0"/>
                </StackPanel>

                <Border Grid.Column="1" Background="#DBEAFE"
                        BorderBrush="#93C5FD" BorderThickness="1"
                        Padding="12,6" VerticalAlignment="Center">
                    <TextBlock x:Name="txtTrangThai"
                               Text="Đang tải..."
                               Foreground="#2563EB"/>
                </Border>
            </Grid>

            <Border Background="White"
                    BorderBrush="#CBD5E1" BorderThickness="1"
                    CornerRadius="4" Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Yêu cầu sửa chữa"
                               FontSize="16" FontWeight="SemiBold"
                               Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Mã yêu cầu"/>
                            <TextBox x:Name="txtMaYeuCau"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Phòng"/>
                            <TextBox x:Name="txtPhong"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Nội dung sự cố"/>
                            <TextBox x:Name="txtNoiDung"
                                     TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Background="White"
                        BorderBrush="#CBD5E1" BorderThickness="1"
                        CornerRadius="4" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Danh sách nhân viên kỹ thuật"
                                   FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Chọn nhân viên cùng dãy, dựa trên lượng công việc đang xử lý."
                                   Margin="0,5,0,14" TextWrapping="Wrap"/>

                        <DataGrid x:Name="dgNhanVien"
                                  Height="280"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  HeadersVisibility="Column"
                                  Background="White"
                                  BorderThickness="0"
                                  SelectionChanged="NhanVien_Changed">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã nhân viên"
                                                    Binding="{Binding MaNhanVien}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="Nhân viên kỹ thuật"
                                                    Binding="{Binding HoTen}"
                                                    Width="1.5*"/>
                                <DataGridTextColumn Header="Công việc đang xử lý"
                                                    Binding="{Binding SoCongViec}"
                                                    Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="White"
                        BorderBrush="#CBD5E1" BorderThickness="1"
                        CornerRadius="4" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Thông tin phân công"
                                   FontSize="16" FontWeight="SemiBold"
                                   Margin="0,0,0,16"/>

                        <TextBlock Text="Nhân viên kỹ thuật *"/>
                        <TextBox x:Name="txtNhanVien"/>

                        <TextBlock Text="Mức độ ưu tiên *"
                                   Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Background="#EFF6FF"
                                    BorderBrush="#BFDBFE"
                                    BorderThickness="1" Padding="12">
                                <RadioButton x:Name="rbBinhThuong"
                                             Content="Bình thường"
                                             GroupName="UuTien"
                                             IsChecked="True"/>
                            </Border>

                            <Border Grid.Column="2"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1" Padding="12">
                                <RadioButton x:Name="rbKhanCap"
                                             Content="Khẩn cấp"
                                             GroupName="UuTien"/>
                            </Border>
                        </Grid>

                        <TextBlock Text="Thời hạn hoàn thành dự kiến *"
                                   Margin="0,0,0,6"/>
                        <DatePicker x:Name="dpHan"
                                    MinHeight="40"
                                    SelectedDateFormat="Short"
                                    Margin="0,0,0,16"/>

                        <TextBlock Text="Trạng thái sau phân công"/>
                        <TextBox Text="Đã phân công"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="#EFF6FF"
                    BorderBrush="#BFDBFE" BorderThickness="1"
                    Padding="14" Margin="0,16,0,0">
                <TextBlock
                    Text="Sau khi lưu, hệ thống ghi thông báo công việc mới cho tài khoản kỹ thuật viên được chọn. Hạn dự kiến được ghi trong lịch sử phân công."
                    Foreground="#2563EB" TextWrapping="Wrap"/>
            </Border>

            <TextBlock x:Name="txtThongBao"
                       Margin="0,14,0,0"
                       Foreground="#DC2626" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="btnQuayLai"
                        Content="Quay lại" Background="#64748B"
                        Click="QuayLai_Click"/>
                <Button x:Name="btnLuu"
                        Content="Lưu phân công"
                        IsEnabled="False"
                        Click="Luu_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>