<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="QuanLyChuoiNhaTro.Views.Management.KhachThueFormView"
             Loaded="View_Loaded"
             Background="#F8FAFC"
             FontFamily="Segoe UI" d:DesignWidth="1404.63">

    <UserControl.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#475569"/>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Margin" Value="0,6,0,16"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Margin" Value="0,6,0,16"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>

        <Style TargetType="{x:Type Button}">
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">
            <TextBlock x:Name="txtTieuDe"
                       Text="Thêm khách thuê"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#0F172A"/>

            <TextBlock Text="Quản lý người đứng tên hợp đồng và thành viên ở cùng."
                       Margin="0,6,0,20"
                       TextWrapping="Wrap"/>

            <Border Background="White"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <Border Padding="18,14"
                            BorderBrush="#E2E8F0"
                            BorderThickness="0,0,0,1">
                        <TextBlock Text="Thông tin khách thuê"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>
                    </Border>

                    <StackPanel x:Name="pnlThongTin" Margin="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="Mã hồ sơ"/>
                                <TextBox x:Name="txtMaKhach"
                                         IsReadOnly="True"
                                         Background="#F8FAFC"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Họ tên *"/>
                                <TextBox x:Name="txtHoTen" MaxLength="100"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1">
                                <TextBlock Text="CCCD *"/>
                                <TextBox x:Name="txtCCCD" MaxLength="12"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Text="Số điện thoại *"/>
                                <TextBox x:Name="txtSoDienThoai" MaxLength="10"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="pnlDiaChi">
                            <TextBlock Text="Địa chỉ thường trú *"/>
                            <TextBox x:Name="txtDiaChi"
                                     MaxLength="255"
                                     Height="70"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalContentAlignment="Top"/>
                        </StackPanel>

                        <TextBlock Text="Dãy trọ *"/>
                        <ComboBox x:Name="cboDayTro"
                                  DisplayMemberPath="TenDayTro"
                                  SelectedValuePath="MaDayTro"
                                  SelectionChanged="DayTro_Changed"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Vai trò trong phòng *"/>
                                <ComboBox x:Name="cboVaiTro"
                                          SelectionChanged="VaiTro_Changed"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Phòng ở"/>
                                <ComboBox x:Name="cboPhong"
                                          DisplayMemberPath="TenHienThi"
                                          SelectedValuePath="MaHopDong"
                                          SelectionChanged="Phong_Changed"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Trạng thái"/>
                        <TextBox x:Name="txtTrangThai"
                                 IsReadOnly="True"
                                 Background="#F8FAFC"/>

                        <Border Background="#EFF6FF"
                                Padding="12"
                                CornerRadius="4">
                            <TextBlock x:Name="txtHuongDan"
                                       TextWrapping="Wrap"
                                       Foreground="#1D4ED8"/>
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="txtThongBao"
                               Margin="18,0,18,16"
                               Foreground="#DC2626"
                               TextWrapping="Wrap"/>

                    <Border BorderBrush="#E2E8F0"
                            BorderThickness="0,1,0,0"
                            Padding="16">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button x:Name="btnQuayLai"
                                    Content="Quay lại"
                                    Background="#64748B"
                                    Click="QuayLai_Click"/>

                            <Button x:Name="btnLuu"
                                    Content="Lưu hồ sơ"
                                    IsEnabled="False"
                                    Click="Luu_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>