<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="QuanLyChuoiNhaTro.Views.Management.BaoCaoView"
             Loaded="View_Loaded"
             Background="#F8FAFC" d:DesignWidth="1205.62" d:DesignHeight="727.63">

    <UserControl.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#475569"/>
        </Style>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,6,0,12"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Báo cáo hàng tháng / năm"
                           FontSize="24" FontWeight="Bold"
                           Foreground="#0F172A"/>
                <TextBlock Text="Lập báo cáo trong phạm vi dãy trọ được phân công."
                           Margin="0,6,0,0"/>
            </StackPanel>
            <Button x:Name="btnXuat" Grid.Column="1"
                    Content="Xuất Excel/PDF"
                    Background="White" Foreground="#2563EB"
                    BorderBrush="#2563EB" BorderThickness="1"
                    VerticalAlignment="Center"
                    IsEnabled="False"
                    Click="Xuat_Click"/>
        </Grid>

        <Border Grid.Row="1" Background="White"
                BorderBrush="#CBD5E1" BorderThickness="1"
                CornerRadius="4" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Điều kiện báo cáo"
                           FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Chọn kỳ, thời gian và nội dung cần tổng hợp."
                           Margin="0,5,0,14"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Dãy trọ"/>
                        <ComboBox x:Name="cboDay"
                                  DisplayMemberPath="TenDayTro"
                                  SelectedValuePath="MaDayTro"
                                  SelectionChanged="DieuKien_Changed"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Loại kỳ báo cáo"/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <RadioButton x:Name="rbThang"
                                         Content="Theo tháng"
                                         GroupName="Ky"
                                         IsChecked="True"
                                         Checked="LoaiKy_Changed"/>
                            <RadioButton x:Name="rbNam"
                                         Content="Theo năm"
                                         GroupName="Ky"
                                         Margin="12,0,0,0"
                                         Checked="LoaiKy_Changed"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Tháng / Năm"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="cboThang"
                                      SelectionChanged="DieuKien_Changed" Margin="0,6,0,12"/>
                            <TextBox x:Name="txtNam" Grid.Column="2"
                                     MaxLength="4"
                                     TextChanged="Nam_Changed"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Nội dung thống kê"/>
                        <ComboBox x:Name="cboNoiDung"
                                  SelectionChanged="DieuKien_Changed">
                            <ComboBoxItem Content="Doanh thu thực thu"/>
                            <ComboBoxItem Content="Hóa đơn và công nợ"/>
                            <ComboBoxItem Content="Phòng trọ hiện tại"/>
                            <ComboBoxItem Content="Yêu cầu sửa chữa"/>
                        </ComboBox>
                    </StackPanel>

                    <Button x:Name="btnTongHop" Grid.Column="7"
                            Content="Tổng hợp dữ liệu"
                            VerticalAlignment="Center"
                            Click="TongHop_Click" Height="52" Margin="8,0,0,0"/>
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.7*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="White"
                    BorderBrush="#CBD5E1" BorderThickness="1"
                    CornerRadius="4" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Bảng số liệu tổng hợp"
                                   FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Kết quả theo điều kiện báo cáo đã chọn."
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                    <DataGrid x:Name="dgBaoCao" Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              Background="White"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nội dung"
                                                Binding="{Binding NoiDung}"
                                                Width="1.8*"/>
                            <DataGridTextColumn Header="Giá trị"
                                                Binding="{Binding HienThi}"
                                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White"
                    BorderBrush="#CBD5E1" BorderThickness="1"
                    CornerRadius="4" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Thông tin báo cáo"
                                   FontSize="16" FontWeight="SemiBold"
                                   Margin="0,0,0,16"/>
                        <TextBlock Text="Người lập"/>
                        <TextBox x:Name="txtNguoiLap"
                                 IsReadOnly="True" Background="#F1F5F9"/>
                        <TextBlock Text="Thời gian"/>
                        <TextBox x:Name="txtThoiGian"
                                 IsReadOnly="True" Background="#F1F5F9"/>
                        <TextBlock Text="Nội dung"/>
                        <TextBox x:Name="txtNoiDung"
                                 IsReadOnly="True" Background="#F1F5F9"
                                 TextWrapping="Wrap"/>
                        <TextBlock Text="Ghi chú / Nhận xét vận hành"/>
                        <TextBox x:Name="txtGhiChu"
                                 Height="110" AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="txtThongBao"
                       Foreground="#64748B"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"/>
            <Button x:Name="btnLuu" Grid.Column="1"
                    Content="Lưu báo cáo"
                    IsEnabled="False"
                    Click="Luu_Click"/>
        </Grid>
    </Grid>
</UserControl>