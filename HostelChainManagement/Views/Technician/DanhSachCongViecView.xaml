<UserControl x:Class="QuanLyChuoiNhaTro.Views.Technician.DanhSachCongViecView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8F9FB"
             Loaded="View_Loaded">

  <UserControl.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="BorderBrush" Value="#D1D7E0"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#F3F4F6"/>
      <Setter Property="Foreground" Value="#475569"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="8,12"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="BorderBrush" Value="#D1D7E0"/>
    </Style>
  </UserControl.Resources>

  <Grid x:Name="editorPanel">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel>
      <Button x:Name="btnRefresh"
              DockPanel.Dock="Right"
              Content="Làm mới"
              Click="Refresh_Click"
              VerticalAlignment="Top"/>

      <StackPanel>
        <TextBlock Text="Danh sách công việc"
                   FontSize="22"
                   FontWeight="SemiBold"/>

        <TextBlock Text="Các yêu cầu sửa chữa được phân công cho nhân viên kỹ thuật."
                   Foreground="#7C8798"
                   TextWrapping="Wrap"
                   Margin="0,4,0,14"/>
      </StackPanel>
    </DockPanel>

    <TextBlock x:Name="txtStatus"
               Grid.Row="1"
               Foreground="#B45309"
               TextWrapping="Wrap"
               Margin="0,0,0,12"/>

    <Border Grid.Row="2"
            Background="White"
            BorderBrush="#D1D7E0"
            BorderThickness="1"
            CornerRadius="3"
            Margin="0,0,0,14">
      <StackPanel>
        <Border BorderBrush="#E1E5EC"
                BorderThickness="0,0,0,1"
                Padding="14,11">
          <TextBlock Text="Bộ lọc"
                     FontWeight="SemiBold"/>
        </Border>

        <Grid Margin="14,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>

          <StackPanel Margin="0,0,10,0">
            <TextBlock Text="Dãy trọ"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"/>

            <ComboBox x:Name="cboDay"
                      Height="34"
                      Padding="8,5"
                      SelectionChanged="Filter_Changed"/>
          </StackPanel>

          <StackPanel Grid.Column="1"
                      Margin="0,0,10,0">
            <TextBlock Text="Số phòng"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"/>

            <TextBox x:Name="txtRoom"
                     Height="34"
                     TextChanged="Room_Changed"/>
          </StackPanel>

          <StackPanel Grid.Column="2">
            <TextBlock Text="Ngày giao việc"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"/>

            <DatePicker x:Name="dpDate"
                        Height="34"
                        SelectedDateChanged="Date_Changed"/>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <Border Grid.Row="3"
            Background="White"
            BorderBrush="#D1D7E0"
            BorderThickness="1"
            CornerRadius="3">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Padding="14,11"
                BorderBrush="#E1E5EC"
                BorderThickness="0,0,0,1">
          <TextBlock Text="Yêu cầu sửa chữa được phân công"
                     FontWeight="SemiBold"/>
        </Border>

        <DataGrid x:Name="jobsGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  RowHeight="38"
                  Background="White"
                  BorderThickness="0"
                  SelectionChanged="Jobs_SelectionChanged"
                  MouseDoubleClick="Jobs_DoubleClick">

          <DataGrid.Columns>
            <DataGridTextColumn Header="Mã yêu cầu"
                                Binding="{Binding MaSuCo}"
                                Width="100"/>

            <DataGridTextColumn Header="Phòng"
                                Binding="{Binding SoPhong}"
                                Width="65"/>

            <DataGridTextColumn Header="Nội dung sự cố"
                                Binding="{Binding NoiDungSuCo}"
                                Width="*"/>

            <DataGridTextColumn Header="Mức độ ưu tiên"
                                Binding="{Binding MucDoUuTien}"
                                Width="100"/>

            <DataGridTextColumn Header="Nhân viên kỹ thuật"
                                Binding="{Binding TenNhanVien}"
                                Width="145"/>

            <DataGridTextColumn Header="Tiến độ"
                                Binding="{Binding TienDo}"
                                Width="110"/>

            <DataGridTextColumn Header="Trạng thái"
                                Binding="{Binding TrangThai}"
                                Width="115"/>
          </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="txtEmpty"
                   Grid.Row="1"
                   Text="Hiện tại bạn không có yêu cầu sửa chữa nào cần xử lý"
                   Foreground="#94A3B8"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"/>
      </Grid>
    </Border>

    <Button x:Name="btnDetail"
            Grid.Row="4"
            Content="Xem chi tiết"
            HorizontalAlignment="Right"
            Background="#2563EB"
            Foreground="White"
            Margin="0,14,0,0"
            IsEnabled="False"
            Click="Detail_Click"/>
  </Grid>
</UserControl>