<UserControl x:Class="QuanLyChuoiNhaTro.Views.Auth.ResetPasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <Style x:Key="PasswordStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#2563EB"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid MinHeight="490" Margin="12">

            <Border Width="390"
                    Padding="26"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    Background="White"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel>
                    <TextBlock Text="Đặt lại mật khẩu"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#111827"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Thông tin tài khoản đã được xác minh."
                               FontSize="12"
                               Foreground="#6B7280"
                               Margin="0,0,0,18"/>

                    <Border Background="#EFF6FF"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            Padding="12"
                            Margin="0,0,0,20">
                        <TextBlock
                            Text="Vui lòng đặt mật khẩu mới để tiếp tục sử dụng hệ thống."
                            Foreground="#1E40AF"
                            FontSize="12"
                            TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="Mật khẩu mới *"
                               Foreground="#374151"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Margin="0,0,0,7"/>

                    <PasswordBox x:Name="pwdNew"
                                 Style="{StaticResource PasswordStyle}"
                                 MaxLength="72"
                                 Margin="0,0,0,17"/>

                    <TextBlock Text="Xác nhận mật khẩu mới *"
                               Foreground="#374151"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Margin="0,0,0,7"/>

                    <PasswordBox x:Name="pwdConfirm"
                                 Style="{StaticResource PasswordStyle}"
                                 MaxLength="72"
                                 Margin="0,0,0,12"/>

                    <TextBlock
                        Text="Mật khẩu từ 8–72 ký tự, có chữ hoa, chữ thường và số."
                        Foreground="#6B7280"
                        FontSize="11"
                        TextWrapping="Wrap"
                        Margin="0,0,0,16"/>

                    <TextBlock x:Name="txtError"
                               Visibility="Collapsed"
                               Foreground="#DC2626"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                    <Button x:Name="btnReset"
                            Content="Đặt lại mật khẩu"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="Reset_Click"/>

                    <Button Content="Quay lại xác minh"
                            Style="{StaticResource LinkButtonStyle}"
                            HorizontalAlignment="Center"
                            Margin="0,13,0,0"
                            Click="BackToIdentity_Click"/>

                    <Button Content="Quay lại đăng nhập"
                            Style="{StaticResource LinkButtonStyle}"
                            HorizontalAlignment="Center"
                            Margin="0,6,0,0"
                            Click="BackToLogin_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>