<UserControl x:Class="QuanLyChuoiNhaTro.Views.Tenant.YeuCauTraPhongView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1000"
             d:DesignHeight="700"
             Background="#F8FAFC"
             Loaded="View_Loaded">

    <UserControl.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,5,0,12"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22">
            <DockPanel>
                <Button x:Name="btnRefresh"
                        DockPanel.Dock="Right"
                        Content="Làm mới"
                        Click="Refresh_Click"/>

                <TextBlock Text="Yêu cầu trả phòng"
                           FontSize="23"
                           FontWeight="Bold"/>
            </DockPanel>

            <Border Background="#FFF7ED"
                    BorderBrush="#FED7AA"
                    BorderThickness="1"
                    Padding="12"
                    Margin="0,14,0,12">

                <TextBlock Text="Vui lòng báo trước theo điều khoản hợp đồng (ví dụ 15 hoặc 30 ngày). Gửi yêu cầu chưa phải là thanh lý hợp đồng; quản lý sẽ liên hệ kiểm tra và bàn giao phòng."
                           TextWrapping="Wrap"
                           Foreground="#9A3412"/>
            </Border>

            <TextBlock x:Name="txtStatus"
                       Foreground="#B45309"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>

            <Border Background="White"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    Padding="20"
                    CornerRadius="4">

                <StackPanel x:Name="formPanel"
                            IsEnabled="False">

                    <TextBlock Text="Hợp đồng đang thuê"/>

                    <ComboBox x:Name="cboHopDong"
                              DisplayMemberPath="MaHopDong"
                              Margin="0,5,0,12"
                              Padding="8"
                              SelectionChanged="Contract_SelectionChanged"/>

                    <Grid x:Name="contractPanel">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Khách thuê"/>

                            <TextBox Text="{Binding HoTen,
                                Mode=OneWay}"
                                     IsReadOnly="True"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Phòng / Dãy trọ"/>

                            <TextBox IsReadOnly="True">
                                <TextBox.Text>
                                    <MultiBinding Mode="OneWay"
                                                  StringFormat="{}{0} — {1}">
                                        <Binding Path="SoPhong"/>
                                        <Binding Path="TenDayTro"/>
                                    </MultiBinding>
                                </TextBox.Text>
                            </TextBox>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Điều khoản hợp đồng"/>

                    <TextBox Text="{Binding DataContext.DieuKhoan,
                                ElementName=contractPanel,
                                Mode=OneWay}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             MinHeight="60"
                             MaxHeight="140"
                             VerticalScrollBarVisibility="Auto"/>

                    <TextBlock Text="Ngày dự kiến trả phòng"/>

                    <DatePicker x:Name="dpNgayTra"
                                Language="vi-VN"
                                SelectedDateFormat="Short"
                                Margin="0,5,0,12"
                                DateValidationError="Date_ValidationError"
                                SelectedDateChanged="Date_Changed"/>

                    <TextBlock Text="Lý do trả phòng / Ghi chú"/>

                    <TextBox x:Name="txtLyDo"
                             MaxLength="255"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="70"/>

                    <TextBlock Text="Thông tin nhận lại tiền cọc (nếu có)"/>

                    <TextBox x:Name="txtHoanCoc"
                             MaxLength="255"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="65"
                             ToolTip="Tên ngân hàng, số tài khoản và tên chủ tài khoản."/>

                    <TextBlock x:Name="txtPending"
                               Foreground="#B45309"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>

                    <Button x:Name="btnSend"
                            Content="Xác nhận gửi yêu cầu"
                            HorizontalAlignment="Right"
                            Background="#2563EB"
                            Foreground="White"
                            Click="Send_Click"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Yêu cầu đã gửi"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,20,0,10"/>

            <DataGrid x:Name="dgYeuCau"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      Background="White"
                      RowHeight="36"
                      MinHeight="170"
                      MaxHeight="300"
                      SelectionChanged="Request_SelectionChanged">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã yêu cầu"
                                        Binding="{Binding MaYeuCau}"
                                        Width="170"/>

                    <DataGridTextColumn Header="Hợp đồng"
                                        Binding="{Binding MaHopDong}"
                                        Width="110"/>

                    <DataGridTextColumn Header="Phòng"
                                        Binding="{Binding SoPhong}"
                                        Width="60"/>

                    <DataGridTextColumn Header="Ngày gửi"
                                        Binding="{Binding NgayYeuCau,
                                            StringFormat={}{0:dd/MM/yyyy}}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Ngày dự kiến trả"
                                        Binding="{Binding NgayDuKienTra,
                                            StringFormat={}{0:dd/MM/yyyy}}"
                                        Width="130"/>

                    <DataGridTextColumn Header="Trạng thái"
                                        Binding="{Binding TrangThai}"
                                        Width="110"/>

                    <DataGridTextColumn Header="Lý do"
                                        Binding="{Binding LyDo}"
                                        Width="*"
                                        MinWidth="120"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock x:Name="txtEmpty"
                       Text="Bạn chưa gửi yêu cầu trả phòng nào."
                       Foreground="#64748B"
                       Margin="0,8,0,0"/>

            <Border x:Name="requestPanel"
                    Background="White"
                    Padding="12"
                    Margin="0,10,0,0"
                    Visibility="Collapsed">

                <StackPanel>
                    <TextBlock Text="Thông tin hoàn cọc đã gửi"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="{Binding ThongTinHoanCoc}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,10"/>

                    <TextBlock Text="Ghi chú xử lý của quản lý"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="{Binding GhiChuXuLy}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Button x:Name="btnCancel"
                    Content="Hủy yêu cầu đã chọn"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0"
                    IsEnabled="False"
                    Click="Cancel_Click"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>