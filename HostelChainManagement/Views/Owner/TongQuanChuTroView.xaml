<UserControl x:Class="QuanLyChuoiNhaTro.Views.Owner.TongQuanChuTroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F9FAFB"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="MinHeight" Value="111"/>
        </Style>

        <Style x:Key="StatValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="23"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>

        <Style x:Key="StatLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="OperationButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="67"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ReportValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="24,18,24,24">

            <Grid Margin="0,0,0,18">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <TextBlock Text="Tổng quan"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#111827"/>

                    <TextBlock Text="Theo dõi tổng quan hoạt động các dãy trọ thuộc quyền quản lý."
                               FontSize="11"
                               Foreground="#6B7280"
                               Margin="0,5,0,0"
                               TextWrapping="Wrap"/>

                </StackPanel>

                <Button Grid.Column="1"
                        x:Name="btnTaiLai"
                        Content="Làm mới dữ liệu"
                        Height="35"
                        Padding="14,7"
                        VerticalAlignment="Center"
                        Background="White"
                        Foreground="#2563EB"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="TaiLai_Click"/>

            </Grid>

            <Grid Margin="0,0,0,16">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource StatCardStyle}">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="37"
                                Height="37"
                                Background="#DBEAFE"
                                CornerRadius="4"
                                VerticalAlignment="Top"
                                Margin="0,0,12,0">

                            <TextBlock Text="DT"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#1D4ED8"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                        <StackPanel Grid.Column="1">

                            <TextBlock Text="TỔNG DÃY TRỌ"
                                       Style="{StaticResource StatLabelStyle}"/>

                            <TextBlock x:Name="txtTongDayTro"
                                       Text="—"
                                       Style="{StaticResource StatValueStyle}"/>

                        </StackPanel>

                    </Grid>

                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource StatCardStyle}">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="37"
                                Height="37"
                                Background="#DCFCE7"
                                CornerRadius="4"
                                VerticalAlignment="Top"
                                Margin="0,0,12,0">

                            <TextBlock Text="NV"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#15803D"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                        <StackPanel Grid.Column="1">

                            <TextBlock Text="NHÂN VIÊN ĐANG LÀM VIỆC"
                                       Style="{StaticResource StatLabelStyle}"/>

                            <TextBlock x:Name="txtNhanVienDangLam"
                                       Text="—"
                                       Style="{StaticResource StatValueStyle}"/>

                        </StackPanel>

                    </Grid>

                </Border>

                <Border Grid.Column="4"
                        Style="{StaticResource StatCardStyle}">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="37"
                                Height="37"
                                Background="#CFFAFE"
                                CornerRadius="4"
                                VerticalAlignment="Top"
                                Margin="0,0,12,0">

                            <TextBlock Text="HĐ"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#0E7490"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                        <StackPanel Grid.Column="1">

                            <TextBlock Text="HỢP ĐỒNG HIỆU LỰC"
                                       Style="{StaticResource StatLabelStyle}"/>

                            <TextBlock x:Name="txtHopDongHieuLuc"
                                       Text="—"
                                       Style="{StaticResource StatValueStyle}"/>

                        </StackPanel>

                    </Grid>

                </Border>

                <Border Grid.Column="6"
                        Style="{StaticResource StatCardStyle}">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="37"
                                Height="37"
                                Background="#FEF3C7"
                                CornerRadius="4"
                                VerticalAlignment="Top"
                                Margin="0,0,12,0">

                            <TextBlock Text="CN"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#B45309"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                        <StackPanel Grid.Column="1">

                            <TextBlock Text="HÓA ĐƠN CÒN NỢ"
                                       Style="{StaticResource StatLabelStyle}"/>

                            <TextBlock x:Name="txtHoaDonConNo"
                                       Text="—"
                                       Style="{StaticResource StatValueStyle}"/>

                        </StackPanel>

                    </Grid>

                </Border>

            </Grid>

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="0.9*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="White"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        CornerRadius="4">

                    <StackPanel>

                        <Border Background="#FAFAFA"
                                BorderBrush="#E5E7EB"
                                BorderThickness="0,0,0,1"
                                Padding="16,13">

                            <StackPanel>

                                <TextBlock Text="Quản lý vận hành"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#111827"/>

                                <TextBlock Text="Các chức năng thuộc quyền Chủ nhà trọ."
                                           FontSize="10"
                                           Foreground="#6B7280"
                                           Margin="0,5,0,0"/>

                            </StackPanel>

                        </Border>

                        <Button Tag="DayTro"
                                Style="{StaticResource OperationButtonStyle}"
                                Click="Navigate_Click">

                            <Grid Margin="16,10">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="34"
                                        Height="34"
                                        Background="#EFF6FF"
                                        CornerRadius="4"
                                        Margin="0,0,12,0">

                                    <TextBlock Text="DT"
                                               Foreground="#1D4ED8"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Border>

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">

                                    <TextBlock Text="Quản lý các dãy trọ"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#111827"/>

                                    <TextBlock Text="Theo dõi và cập nhật các dãy trọ."
                                               FontSize="10"
                                               Foreground="#6B7280"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"/>

                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           Text="›"
                                           FontSize="21"
                                           Foreground="#94A3B8"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"/>

                            </Grid>

                        </Button>

                        <Button Tag="NhanVien"
                                Style="{StaticResource OperationButtonStyle}"
                                Click="Navigate_Click">

                            <Grid Margin="16,10">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="34"
                                        Height="34"
                                        Background="#EFF6FF"
                                        CornerRadius="4"
                                        Margin="0,0,12,0">

                                    <TextBlock Text="NV"
                                               Foreground="#1D4ED8"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Border>

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">

                                    <TextBlock Text="Quản lý nhân viên"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#111827"/>

                                    <TextBlock Text="Theo dõi nhân viên quản lý và kỹ thuật."
                                               FontSize="10"
                                               Foreground="#6B7280"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"/>

                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           Text="›"
                                           FontSize="21"
                                           Foreground="#94A3B8"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"/>

                            </Grid>

                        </Button>

                        <Button Tag="PhanCong"
                                Style="{StaticResource OperationButtonStyle}"
                                Click="Navigate_Click">

                            <Grid Margin="16,10">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="34"
                                        Height="34"
                                        Background="#EFF6FF"
                                        CornerRadius="4"
                                        Margin="0,0,12,0">

                                    <TextBlock Text="PC"
                                               Foreground="#1D4ED8"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Border>

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">

                                    <TextBlock Text="Phân công nhân viên quản lý"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#111827"/>

                                    <TextBlock Text="Phân công người phụ trách từng dãy trọ."
                                               FontSize="10"
                                               Foreground="#6B7280"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"/>

                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           Text="›"
                                           FontSize="21"
                                           Foreground="#94A3B8"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"/>

                            </Grid>

                        </Button>

                        <Button Tag="HopDong"
                                Style="{StaticResource OperationButtonStyle}"
                                Click="Navigate_Click">

                            <Grid Margin="16,10">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="34"
                                        Height="34"
                                        Background="#EFF6FF"
                                        CornerRadius="4"
                                        Margin="0,0,12,0">

                                    <TextBlock Text="HĐ"
                                               Foreground="#1D4ED8"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Border>

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">

                                    <TextBlock Text="Xem hợp đồng &amp; hóa đơn"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#111827"/>

                                    <TextBlock Text="Tra cứu hợp đồng và hóa đơn thuộc các dãy."
                                               FontSize="10"
                                               Foreground="#6B7280"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"/>

                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           Text="›"
                                           FontSize="21"
                                           Foreground="#94A3B8"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"/>

                            </Grid>

                        </Button>

                    </StackPanel>

                </Border>

                <Border Grid.Column="2"
                        Background="White"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        CornerRadius="4">

                    <StackPanel>

                        <Border Background="#FAFAFA"
                                BorderBrush="#E5E7EB"
                                BorderThickness="0,0,0,1"
                                Padding="16,13">

                            <StackPanel>

                                <TextBlock Text="Thông tin báo cáo"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#111827"/>

                                <TextBlock Text="Dữ liệu tổng hợp từ các dãy trọ."
                                           FontSize="10"
                                           Foreground="#6B7280"
                                           Margin="0,5,0,0"/>

                            </StackPanel>

                        </Border>

                        <Border BorderBrush="#E5E7EB"
                                BorderThickness="0,0,0,1"
                                Padding="16,18">

                            <StackPanel>

                                <TextBlock Text="Tổng doanh thu đã thu"
                                           FontSize="11"
                                           Foreground="#374151"/>

                                <TextBlock x:Name="txtDoanhThuDaThu"
                                           Text="— VNĐ"
                                           Style="{StaticResource ReportValueStyle}"/>

                            </StackPanel>

                        </Border>

                        <Border BorderBrush="#E5E7EB"
                                BorderThickness="0,0,0,1"
                                Padding="16,18">

                            <StackPanel>

                                <TextBlock Text="Tổng công nợ tồn đọng"
                                           FontSize="11"
                                           Foreground="#374151"/>

                                <TextBlock x:Name="txtTongCongNo"
                                           Text="— VNĐ"
                                           Style="{StaticResource ReportValueStyle}"/>

                            </StackPanel>

                        </Border>

                        <Border BorderBrush="#E5E7EB"
                                BorderThickness="0,0,0,1"
                                Padding="16,18">

                            <StackPanel>

                                <TextBlock Text="Phòng chưa thanh toán"
                                           FontSize="11"
                                           Foreground="#374151"/>

                                <TextBlock x:Name="txtPhongChuaThanhToan"
                                           Text="—"
                                           Style="{StaticResource ReportValueStyle}"/>

                                <TextBlock Text="Đếm theo phòng có hóa đơn còn phải thu."
                                           FontSize="10"
                                           Foreground="#9CA3AF"
                                           TextWrapping="Wrap"
                                           Margin="0,5,0,0"/>

                            </StackPanel>

                        </Border>

                        <Button Content="Xem báo cáo chi tiết →"
                                Tag="BaoCao"
                                Margin="16,14"
                                Padding="14,9"
                                Height="37"
                                Background="#2563EB"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Click="Navigate_Click"/>

                    </StackPanel>

                </Border>

            </Grid>

            <TextBlock x:Name="txtTrangThaiTai"
                       Text="Đang tải dữ liệu tổng quan..."
                       FontSize="11"
                       Foreground="#6B7280"
                       TextWrapping="Wrap"
                       Margin="0,13,0,0"/>

        </StackPanel>

    </ScrollViewer>

</UserControl>
