<Window x:Class="QuanLyChuoiNhaTro.Views.Management.QuanLyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nhân viên quản lý — Quản lý nhà trọ"
        Width="1250" Height="760"
        MinWidth="1050" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="MenuStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="MenuBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="3">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MenuBorder"
                                        Property="Background"
                                        Value="#334155"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#1E293B">
            <DockPanel>
                <Border DockPanel.Dock="Top"
                        Background="#0F172A"
                        Padding="16">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36"
                                Background="#2563EB"
                                CornerRadius="3">
                            <TextBlock Text="NT"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="QUẢN LÝ NHÀ TRỌ"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="12"/>
                            <TextBlock Text="Hệ thống quản lý"
                                       Foreground="#94A3B8"
                                       FontSize="10"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Button DockPanel.Dock="Bottom"
                        Content="↪  Đăng xuất"
                        Style="{StaticResource MenuStyle}"
                        Foreground="#FCA5A5"
                        Margin="10"
                        Click="Logout_Click"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,18">
                        <TextBlock Text="TỔNG QUAN"
                                   Foreground="#94A3B8"
                                   FontSize="10"
                                   Margin="8,0,0,8"/>

                        <Button x:Name="btnOverview"
                                Content="Tổng quan"
                                Background="#2563EB"
                                Foreground="White"
                                Style="{StaticResource MenuStyle}"
                                Click="Overview_Click"/>

                        <Separator Background="#334155" Margin="0,12"/>

                        <TextBlock Text="QUẢN LÝ"
                                   Foreground="#94A3B8"
                                   FontSize="10"
                                   Margin="8,0,0,8"/>

                        <Button x:Name="btnRooms"
                                Content="Phòng trọ"
                                Style="{StaticResource MenuStyle}"/>
                        <Button x:Name="btnTenants"
                                Content="Khách thuê"
                                Style="{StaticResource MenuStyle}"/>
                        <Button x:Name="btnContracts"
                                Content="Hợp đồng"
                                Style="{StaticResource MenuStyle}"/>
                        <Button x:Name="btnInvoices"
                                Content="Hóa đơn"
                                Style="{StaticResource MenuStyle}"/>
                        <Button x:Name="btnRepairs"
                                Content="Sửa chữa"
                                Style="{StaticResource MenuStyle}"/>
                        <Button x:Name="btnNotifications"
                                Content="Thông báo"
                                Style="{StaticResource MenuStyle}"/>

                        <Separator Background="#334155" Margin="0,12"/>

                        <TextBlock Text="THỐNG KÊ"
                                   Foreground="#94A3B8"
                                   FontSize="10"
                                   Margin="8,0,0,8"/>
                        <Button x:Name="btnReports"
                                Content="Báo cáo"
                                Style="{StaticResource MenuStyle}"/>

                        <Separator Background="#334155" Margin="0,12"/>

                        <TextBlock Text="TÀI KHOẢN"
                                   Foreground="#94A3B8"
                                   FontSize="10"
                                   Margin="8,0,0,8"/>
                        <Button x:Name="btnProfile"
                                Content="Hồ sơ cá nhân"
                                Style="{StaticResource MenuStyle}"
                                Click="Profile_Click"/>
                        <Button x:Name="btnPassword"
                                Content="Đổi mật khẩu"
                                Style="{StaticResource MenuStyle}"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,0,0,1"
                    Padding="22,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="txtUser"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Nhân viên quản lý"
                                   Foreground="#64748B"
                                   FontSize="11"/>
                    </StackPanel>

                    <TextBlock x:Name="txtBreadcrumb"
                               Text="Hệ thống / Tổng quan"
                               Foreground="#64748B"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <ContentControl x:Name="contentArea" Grid.Row="1"/>
        </Grid>
    </Grid>
</Window>