<UserControl x:Class="QuanLyChuoiNhaTro.Views.Management.TaoHoaDonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="View_Loaded"
             Background="#F8FAFC">

    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#475569"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Margin" Value="0,6,0,14"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Margin" Value="0,6,0,14"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="DongPhi" TargetType="Border">
            <Setter Property="Padding" Value="0,12"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Tạo hóa đơn hàng tháng"
                               FontSize="24" FontWeight="Bold"
                               Foreground="#0F172A"/>
                    <TextBlock Text="Lập hóa đơn cho phòng đang có hợp đồng phù hợp với kỳ đã chọn."
                               Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <Button x:Name="btnToanDay" Grid.Column="1"
                        Content="Tạo hóa đơn toàn dãy"
                        Background="White" Foreground="#2563EB"
                        BorderBrush="#2563EB" BorderThickness="1"
                        VerticalAlignment="Center"
                        IsEnabled="False"
                        Click="ToanDay_Click"/>
            </Grid>

            <Grid x:Name="pnlThongTin">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Khung bên trái -->
                <Border Background="White"
                        BorderBrush="#CBD5E1" BorderThickness="1"
                        CornerRadius="4" VerticalAlignment="Top">
                    <StackPanel>
                        <Border Padding="18,14"
                                BorderBrush="#E2E8F0"
                                BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock Text="Thông tin hóa đơn"
                                           FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="Chọn phòng và kỳ cần lập hóa đơn."
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="18">
                            <TextBlock Text="Mã hóa đơn"/>
                            <TextBox x:Name="txtMaHoaDon"
                                     IsReadOnly="True" Background="#F1F5F9"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Phòng *"/>
                                    <ComboBox x:Name="cboPhong"
                                              DisplayMemberPath="TenHienThi"
                                              SelectionChanged="Phong_Changed"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Khách thuê"/>
                                    <TextBox x:Name="txtKhach"
                                             IsReadOnly="True"
                                             Background="#F1F5F9"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Kỳ hóa đơn *"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox x:Name="cboThang"
                                          SelectionChanged="Thang_Changed"/>

                                <TextBox x:Name="txtNam"
                                         Grid.Column="2"
                                         MaxLength="4"
                                         LostFocus="Nam_LostFocus"/>
                            </Grid>

                            <TextBlock Text="Trạng thái chỉ số điện nước"/>
                            <TextBox x:Name="txtChiSo"
                                     IsReadOnly="True"
                                     Background="#F1F5F9"
                                     Cursor="Hand"
                                     ToolTip="Nhấn để nhập hoặc sửa dữ liệu điện nước và phí dịch vụ"
                                     PreviewMouseLeftButtonUp="NhapDuLieu_Click"/>

                            <Border Background="#EFF6FF"
                                    BorderBrush="#BFDBFE"
                                    BorderThickness="1" Padding="12">
                                <TextBlock
                                    Text="Hóa đơn được lập khi đã nhập dữ liệu điện nước của kỳ hiện tại. Nhấn ô trạng thái phía trên để nhập."
                                    Foreground="#2563EB" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Khung bên phải -->
                <Border Grid.Column="2" Background="White"
                        BorderBrush="#CBD5E1" BorderThickness="1"
                        CornerRadius="4" VerticalAlignment="Top">
                    <StackPanel>
                        <Border Padding="18,14"
                                BorderBrush="#E2E8F0"
                                BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock Text="Chi tiết chi phí"
                                           FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="Các khoản được tính theo dữ liệu của phòng và kỳ hóa đơn."
                                           Margin="0,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="18">
                            <Border Style="{StaticResource DongPhi}">
                                <DockPanel>
                                    <TextBlock x:Name="txtTienPhong"
                                               DockPanel.Dock="Right"/>
                                    <StackPanel>
                                        <TextBlock Text="Tiền phòng"/>
                                        <TextBlock Text="Theo hợp đồng thuê"
                                                   Foreground="#94A3B8" FontSize="11"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource DongPhi}">
                                <DockPanel>
                                    <TextBlock x:Name="txtTienDien"
                                               DockPanel.Dock="Right"/>
                                    <StackPanel>
                                        <TextBlock Text="Điện"/>
                                        <TextBlock Text="Theo lượng tiêu thụ của kỳ"
                                                   Foreground="#94A3B8" FontSize="11"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource DongPhi}">
                                <DockPanel>
                                    <TextBlock x:Name="txtTienNuoc"
                                               DockPanel.Dock="Right"/>
                                    <StackPanel>
                                        <TextBlock Text="Nước"/>
                                        <TextBlock Text="Theo lượng tiêu thụ của kỳ"
                                                   Foreground="#94A3B8" FontSize="11"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource DongPhi}">
                                <DockPanel>
                                    <TextBlock x:Name="txtPhiRac"
                                               DockPanel.Dock="Right"/>
                                    <TextBlock Text="Phí rác"/>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource DongPhi}">
                                <DockPanel>
                                    <TextBlock x:Name="txtInternet"
                                               DockPanel.Dock="Right"/>
                                    <TextBlock Text="Internet"/>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource DongPhi}">
                                <DockPanel>
                                    <TextBlock x:Name="txtPhiDichVu"
                                               DockPanel.Dock="Right"/>
                                    <TextBlock Text="Phí dịch vụ"/>
                                </DockPanel>
                            </Border>

                            <TextBlock Text="Phụ phí phát sinh (VNĐ)"
                                       Margin="0,16,0,0"/>
                            <TextBox x:Name="txtPhuPhi" Text="0"
                                     TextChanged="PhuPhi_Changed"
                                     ToolTip="Số nguyên không âm, không nhập dấu phân cách hàng nghìn"/>

                            <Border Background="#EFF6FF"
                                    BorderBrush="#BFDBFE"
                                    BorderThickness="1" Padding="12">
                                <DockPanel>
                                    <TextBlock x:Name="txtTongTien"
                                               DockPanel.Dock="Right"
                                               FontWeight="Bold"
                                               Foreground="#2563EB"/>
                                    <TextBlock Text="Tổng tiền" FontWeight="SemiBold"/>
                                </DockPanel>
                            </Border>

                            <DockPanel Margin="0,14,0,0">
                                <Border DockPanel.Dock="Right"
                                        Background="#FEF3C7" Padding="8,4">
                                    <TextBlock Text="CHƯA THANH TOÁN"
                                               Foreground="#B45309" FontSize="10"/>
                                </Border>
                                <TextBlock Text="Trạng thái sau khi phát hành"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock x:Name="txtThongBao"
                       Margin="0,14,0,0"
                       Foreground="#DC2626" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <Button x:Name="btnQuayLai" Content="Quay lại"
                        Background="#64748B"
                        Click="QuayLai_Click"/>
                <Button x:Name="btnLuu" Content="Phát hành hóa đơn"
                        IsEnabled="False"
                        Click="Luu_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>