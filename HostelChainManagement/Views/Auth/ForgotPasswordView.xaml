<UserControl x:Class="QuanLyChuoiNhaTro.Views.Auth.ForgotPasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <Style x:Key="AuthInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="AuthPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AuthLinkStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#2563EB"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid MinHeight="520" Margin="12,15">

                <Border Width="390"
                        Padding="26"
                        Background="White"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        CornerRadius="3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                    <StackPanel>

                        <TextBlock Text="Quên mật khẩu"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   Margin="0,0,0,8"/>

                        <TextBlock
                            Text="Nhập email đã đăng ký trong tài khoản để khôi phục mật khẩu."
                            FontSize="12"
                            Foreground="#6B7280"
                            TextWrapping="Wrap"
                            LineHeight="19"
                            Margin="0,0,0,24"/>

                        <TextBlock FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"
                                   Margin="0,0,0,7">
                            <Run Text="Email"/>
                            <Run Text=" *" Foreground="#DC2626"/>
                        </TextBlock>

                        <TextBox x:Name="txtEmail"
                                 Style="{StaticResource AuthInputStyle}"
                                 MaxLength="100"
                                 ToolTip="Nhập email đã đăng ký"
                                 Margin="0,0,0,17"/>

                        <Border Background="#EFF6FF"
                                BorderBrush="#BFDBFE"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="12"
                                Margin="0,0,0,17">

                            <TextBlock
                                Text="Mã OTP sẽ được gửi đến email đã đăng ký và có hiệu lực trong 5 phút khi chức năng được hoàn thiện."
                                FontSize="12"
                                Foreground="#1E40AF"
                                TextWrapping="Wrap"
                                LineHeight="19"/>
                        </Border>

                        <TextBlock x:Name="txtError"
                                   Visibility="Collapsed"
                                   FontSize="12"
                                   Foreground="#DC2626"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>

                        <Button Content="Gửi mã xác nhận"
                                Style="{StaticResource AuthPrimaryButtonStyle}"
                                Click="SendCode_Click"/>

                        <Button Content="Quay lại đăng nhập"
                                Style="{StaticResource AuthLinkStyle}"
                                Margin="0,15,0,0"
                                Click="BackToLogin_Click"/>

                        <TextBlock
                            Text="Bản xem trước giao diện — chưa gửi email thực tế."
                            Foreground="#9CA3AF"
                            FontSize="10"
                            TextAlignment="Center"
                            Margin="0,15,0,0"
                            TextWrapping="Wrap"/>

                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>