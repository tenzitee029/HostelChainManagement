<UserControl x:Class="QuanLyChuoiNhaTro.Views.Management.PhongTroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="1000"
             Loaded="View_Loaded"
             Background="#F8FAFC">

    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Quản lý phòng trọ"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#0F172A"/>

                <TextBlock Text="Quản lý thông tin phòng thuộc dãy trọ được phân công."
                           Margin="0,6,0,0"
                           Foreground="#64748B"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="+ Thêm phòng"
                    VerticalAlignment="Center"
                    Click="AddRoom_Click"/>
        </Grid>

        <!-- Tìm kiếm -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="4"
                Padding="16"
                Margin="0,0,0,16">

            <StackPanel>
                <TextBlock Text="Tìm kiếm phòng"
                           FontWeight="SemiBold"
                           Foreground="#334155"
                           Margin="0,0,0,8"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="txtSearch"
                             Padding="10,8"
                             BorderBrush="#CBD5E1"
                             VerticalContentAlignment="Center"
                             ToolTip="Nhập mã phòng, số phòng, dãy hoặc trạng thái"/>

                    <Button Grid.Column="1"
                            Content="Tìm kiếm"
                            Margin="12,0,0,0"
                            Click="Search_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Danh sách phòng -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="4">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Danh sách phòng"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A"/>

                        <TextBlock Text="Các phòng thuộc phạm vi dãy trọ được phân công."
                                   Foreground="#64748B"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Border Background="#DCFCE7"
                                Padding="8,4"
                                Margin="4">
                            <TextBlock Text="TRỐNG"
                                       Foreground="#15803D"
                                       FontSize="10"
                                       FontWeight="Bold"/>
                        </Border>

                        <Border Background="#DBEAFE"
                                Padding="8,4"
                                Margin="4">
                            <TextBlock Text="ĐANG THUÊ"
                                       Foreground="#2563EB"
                                       FontSize="10"
                                       FontWeight="Bold"/>
                        </Border>

                        <Border Background="#FEF3C7"
                                Padding="8,4"
                                Margin="4">
                            <TextBlock Text="ĐANG SỬA CHỮA"
                                       Foreground="#B45309"
                                       FontSize="10"
                                       FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <DataGrid x:Name="dgPhong"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          SelectionChanged="dgPhong_SelectionChanged"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E2E8F0"
                          BorderThickness="0"
                          RowHeight="42"
                          Background="White"
                          AlternatingRowBackground="#F8FAFC">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã phòng"
                                            Binding="{Binding MaPhong}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Số phòng"
                                            Binding="{Binding SoPhong}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Dãy trọ"
                                            Binding="{Binding TenDayTro}"
                                            Width="1.5*"/>

                        <DataGridTextColumn Header="Loại phòng"
                                            Binding="{Binding LoaiPhong}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Diện tích (m²)"
                                            Binding="{Binding DienTich}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Giá thuê (VNĐ)"
                                            Binding="{Binding GiaThue, StringFormat={}{0:N0}}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Trạng thái"
                                            Binding="{Binding TrangThai}"
                                            Width="1.3*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Nút thao tác -->
                <Border Grid.Row="2"
                        BorderBrush="#E2E8F0"
                        BorderThickness="0,1,0,0"
                        Padding="12">

                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal">

                            <Button x:Name="btnXoa"
                                    Content="Xóa"
                                    Background="#DC2626"
                                    IsEnabled="False"
                                    Click="XoaPhong_Click"/>

                            <Button x:Name="btnSua"
                                    Content="Sửa"
                                    IsEnabled="False"
                                    Click="SuaPhong_Click"/>
                        </StackPanel>

                        <TextBlock Text="Chọn một phòng để sửa hoặc xóa."
                                   Foreground="#64748B"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <TextBlock x:Name="txtStatus"
                   Grid.Row="3"
                   Margin="0,12,0,0"
                   Foreground="#64748B"
                   TextWrapping="Wrap"/>
    </Grid>
</UserControl>