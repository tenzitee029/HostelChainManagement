<UserControl x:Class="QuanLyChuoiNhaTro.Views.Owner.NhacNoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F9FAFB"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,11"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="9,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="43"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>

            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="24,18,24,20">

            <Grid Margin="0,0,0,15">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <TextBlock Text="Nhắc nợ khách thuê"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#111827"/>

                    <TextBlock Text="Lập nội dung nhắc thanh toán cho những hóa đơn đã quá hạn."
                               FontSize="11"
                               Foreground="#6B7280"
                               Margin="0,5,0,0"
                               TextWrapping="Wrap"/>

                </StackPanel>

                <Button Grid.Column="1"
                        Content="← Quay lại báo cáo"
                        Height="36"
                        Padding="14,7"
                        Background="White"
                        Foreground="#374151"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        Click="QuayLai_Click"/>

            </Grid>

            <Border Background="White"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="4"
                    Margin="0,0,0,14">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#FAFAFA"
                            BorderBrush="#E5E7EB"
                            BorderThickness="0,0,0,1"
                            Padding="16,12">

                        <StackPanel>

                            <TextBlock Text="Danh sách hóa đơn quá hạn"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#111827"/>

                            <TextBlock Text="Chọn một hoặc nhiều hóa đơn. Giữ Ctrl để chọn nhiều dòng."
                                       FontSize="10"
                                       Foreground="#6B7280"
                                       Margin="0,5,0,0"/>

                        </StackPanel>

                    </Border>

                    <Grid Grid.Row="1"
                          Margin="16,12,16,12">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock Text="Chọn phòng"
                                       Style="{StaticResource FormLabelStyle}"/>

                            <ComboBox x:Name="cmbPhong"
                                      Height="36"
                                      Padding="9,5"
                                      FontSize="11"
                                      BorderBrush="#CBD5E1"
                                      Background="White"
                                      MinWidth="230"
                                      HorizontalAlignment="Left"
                                      SelectionChanged="Phong_SelectionChanged"
                                      IsEnabled="False"/>

                        </StackPanel>

                        <Button Grid.Column="1"
                                x:Name="btnTaiLai"
                                Content="Tải lại danh sách"
                                Background="White"
                                Foreground="#2563EB"
                                BorderBrush="#BFDBFE"
                                BorderThickness="1"
                                Padding="12,7"
                                Height="36"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                VerticalAlignment="Bottom"
                                Click="TaiLai_Click"/>

                    </Grid>

                    <Grid Grid.Row="2"
                          Margin="0,0,0,12">

                        <DataGrid x:Name="dgvNoQuaHan"
                                  Height="245"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  SelectionUnit="FullRow"
                                  SelectionMode="Extended"
                                  RowHeaderWidth="0"
                                  BorderThickness="0"
                                  Background="White"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E5E7EB"
                                  FontSize="11"
                                  HorizontalScrollBarVisibility="Auto"
                                  SelectionChanged="NoQuaHan_SelectionChanged">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Mã hóa đơn"
                                                    Binding="{Binding MaHoaDon}"
                                                    MinWidth="110"
                                                    Width="1*"/>

                                <DataGridTextColumn Header="Dãy trọ"
                                                    Binding="{Binding TenDayTro}"
                                                    MinWidth="135"
                                                    Width="1.3*"/>

                                <DataGridTextColumn Header="Phòng"
                                                    Binding="{Binding SoPhong}"
                                                    MinWidth="75"
                                                    Width="0.65*"/>

                                <DataGridTextColumn Header="Khách thuê"
                                                    Binding="{Binding HoTenKhach}"
                                                    MinWidth="140"
                                                    Width="1.3*"/>

                                <DataGridTextColumn Header="Hạn thanh toán"
                                                    Binding="{Binding HanThanhToan, StringFormat={}{0:dd/MM/yyyy}}"
                                                    MinWidth="115"
                                                    Width="1*"/>

                                <DataGridTextColumn Header="Còn nợ"
                                                    Binding="{Binding ConNo, StringFormat={}{0:N0}}"
                                                    MinWidth="115"
                                                    Width="1*"/>

                            </DataGrid.Columns>

                        </DataGrid>

                        <TextBlock x:Name="txtEmptyState"
                                   Text="Đang tải danh sách..."
                                   FontSize="11"
                                   Foreground="#9CA3AF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   IsHitTestVisible="False"
                                   Margin="20"/>

                    </Grid>

                </Grid>

            </Border>

            <Border Background="White"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="4">

                <StackPanel>

                    <Border Background="#FAFAFA"
                            BorderBrush="#E5E7EB"
                            BorderThickness="0,0,0,1"
                            Padding="16,12">

                        <TextBlock Text="Soạn thông báo nhắc nợ"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"/>

                    </Border>

                    <Grid Margin="16,16,16,14">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock Text="Tổng số tiền còn nợ đã chọn"
                                       Style="{StaticResource FormLabelStyle}"/>

                            <TextBox x:Name="txtTongTien"
                                     Text="—"
                                     Height="36"
                                     Padding="10,7"
                                     Background="#F9FAFB"
                                     BorderBrush="#D1D5DB"
                                     IsReadOnly="True"
                                     FontSize="11"
                                     VerticalContentAlignment="Center"/>

                        </StackPanel>

                        <StackPanel Grid.Column="2">

                            <TextBlock Text="Hạn chót đề nghị thanh toán"
                                       Style="{StaticResource FormLabelStyle}"/>

                            <DatePicker x:Name="dpHanChot"
                                        Height="36"
                                        FontSize="11"
                                        BorderBrush="#CBD5E1"
                                        SelectedDateChanged="HanChot_SelectedDateChanged"/>

                        </StackPanel>

                    </Grid>

                    <StackPanel Margin="16,0,16,14">

                        <TextBlock Text="Mẫu nội dung tin nhắn"
                                   Style="{StaticResource FormLabelStyle}"/>

                        <TextBox x:Name="txtNoiDung"
                                 Height="145"
                                 Padding="11,9"
                                 FontSize="11"
                                 Foreground="#374151"
                                 Background="White"
                                 BorderBrush="#CBD5E1"
                                 VerticalScrollBarVisibility="Auto"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalContentAlignment="Top"/>

                    </StackPanel>

                    <Border Background="#FAFAFA"
                            BorderBrush="#E5E7EB"
                            BorderThickness="0,1,0,0"
                            Padding="16,12">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="txtThongBao"
                                       Grid.Column="0"
                                       Text="Chọn hóa đơn quá hạn để lập nội dung nhắc nợ."
                                       FontSize="11"
                                       Foreground="#6B7280"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>

                            <Button Grid.Column="1"
                                    x:Name="btnGuiNhacNo"
                                    Content="Gửi thông báo nhắc nợ"
                                    Height="36"
                                    MinWidth="165"
                                    Padding="14,8"
                                    Background="#2563EB"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    IsEnabled="False"
                                    ToolTip="Chức năng gửi thật sẽ được kết nối ở bước tiếp theo"/>

                        </Grid>

                    </Border>

                </StackPanel>

            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>
