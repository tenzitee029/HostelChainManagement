<UserControl x:Class="QuanLyChuoiNhaTro.Views.Auth.ForgotPasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#2563EB"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid MinHeight="490" Margin="12">

            <Border Width="390"
                    Padding="26"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    Background="White"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel>
                    <TextBlock Text="Quên mật khẩu"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#111827"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Xác minh thông tin đã đăng ký để đặt lại mật khẩu tài khoản."
                               FontSize="12"
                               Foreground="#6B7280"
                               TextWrapping="Wrap"
                               Margin="0,0,0,24"/>

                    <TextBlock Text="Số căn cước công dân (CCCD) *"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#374151"
                               Margin="0,0,0,7"/>

                    <TextBox x:Name="txtCccd"
                             Style="{StaticResource InputStyle}"
                             MaxLength="12"
                             ToolTip="Nhập 12 chữ số CCCD"
                             Margin="0,0,0,17"/>

                    <TextBlock Text="Số điện thoại đã đăng ký *"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#374151"
                               Margin="0,0,0,7"/>

                    <TextBox x:Name="txtPhone"
                             Style="{StaticResource InputStyle}"
                             MaxLength="15"
                             ToolTip="Nhập số điện thoại của tài khoản"
                             Margin="0,0,0,18"/>

                    <Border Background="#EFF6FF"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            Padding="12"
                            Margin="0,0,0,18">
                        <TextBlock
                            Text="Thông tin CCCD và số điện thoại phải trùng khớp với dữ liệu tài khoản trong hệ thống."
                            FontSize="12"
                            Foreground="#1E40AF"
                            TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock x:Name="txtError"
                               Visibility="Collapsed"
                               Foreground="#DC2626"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                    <Button x:Name="btnVerify"
                            Content="Xác minh thông tin"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="Verify_Click"/>

                    <Button Content="Quay lại đăng nhập"
                            Style="{StaticResource LinkButtonStyle}"
                            HorizontalAlignment="Center"
                            Margin="0,14,0,0"
                            Click="BackToLogin_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>