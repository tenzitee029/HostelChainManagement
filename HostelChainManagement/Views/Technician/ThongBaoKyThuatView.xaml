<UserControl x:Class="QuanLyChuoiNhaTro.Views.Technician.ThongBaoKyThuatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8F9FB"
             Loaded="View_Loaded">

  <UserControl.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#F3F4F6"/>
      <Setter Property="Foreground" Value="#475569"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="8,12"/>
    </Style>
  </UserControl.Resources>

  <Grid x:Name="editorPanel">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="240"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <DockPanel Margin="0,0,0,12">
      <Button DockPanel.Dock="Right"
              Content="Tải lại"
              Click="Notifications_Click"/>

      <TextBlock Text="Thông báo"
                 FontSize="22"
                 FontWeight="SemiBold"/>
    </DockPanel>

    <TextBlock x:Name="txtStatus"
               Grid.Row="1"
               Foreground="#B45309"
               TextWrapping="Wrap"
               Margin="0,0,0,12"/>

    <DataGrid x:Name="notificationsGrid"
              Grid.Row="2"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              SelectionMode="Single"
              SelectionUnit="FullRow"
              HeadersVisibility="Column"
              RowHeight="38"
              Background="White"
              BorderBrush="#D1D7E0"
              SelectionChanged="Notification_SelectionChanged">

      <DataGrid.Columns>
        <DataGridCheckBoxColumn Header="Đã đọc"
                                Binding="{Binding DaDoc}"
                                Width="65"/>
        <DataGridTextColumn Header="Tiêu đề"
                            Binding="{Binding TieuDe}"
                            Width="*"/>
        <DataGridTextColumn Header="Người gửi"
                            Binding="{Binding NguoiGui}"
                            Width="180"/>
        <DataGridTextColumn Header="Thời điểm"
                            Binding="{Binding NgayGui, StringFormat=dd/MM/yyyy HH:mm}"
                            Width="150"/>
      </DataGrid.Columns>
    </DataGrid>

    <TextBox x:Name="txtNotification"
             Grid.Row="3"
             IsReadOnly="True"
             TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto"
             Padding="12"
             Margin="0,12,0,0"/>
  </Grid>
</UserControl>