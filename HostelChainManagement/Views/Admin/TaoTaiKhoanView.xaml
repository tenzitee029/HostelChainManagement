<UserControl x:Class="QuanLyChuoiNhaTro.Views.Admin.TaoTaiKhoanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="viewRoot"
             Background="#F8F9FB">

  <UserControl.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="BorderBrush" Value="#D1D7E0"/>
    </Style>

    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="#475569"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
  </UserControl.Resources>

  <Grid x:Name="editorPanel">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Width="{Binding ActualWidth, ElementName=viewRoot}"
                  MaxWidth="750"
                  HorizontalAlignment="Left">

        <TextBlock Text="Tạo tài khoản mới"
                   FontSize="22"
                   FontWeight="SemiBold"/>

        <TextBlock Text="Nhập thông tin tài khoản người dùng cần tạo."
                   Foreground="#7C8798"
                   Margin="0,4,0,12"/>

        <Border Background="White"
                BorderBrush="#D1D7E0"
                BorderThickness="1"
                CornerRadius="3">
          <StackPanel>
            <Border Padding="14,11"
                    BorderBrush="#E1E5EC"
                    BorderThickness="0,0,0,1">
              <TextBlock Text="Thông tin tài khoản"
                         FontWeight="SemiBold"/>
            </Border>

            <Grid Margin="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>

              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <StackPanel Margin="0,0,14,14">
                <TextBlock Text="Tên đăng nhập"
                           Style="{StaticResource Label}"/>
                <TextBox x:Name="txtNewLogin"
                         MaxLength="50"/>
              </StackPanel>

              <StackPanel Grid.Column="1"
                          Margin="0,0,0,14">
                <TextBlock Text="Email"
                           Style="{StaticResource Label}"/>
                <TextBox x:Name="txtNewEmail"
                         MaxLength="100"/>
              </StackPanel>

              <StackPanel Grid.Row="1"
                          Margin="0,0,14,14">
                <TextBlock Text="SĐT"
                           Style="{StaticResource Label}"/>
                <TextBox x:Name="txtNewPhone"
                         MaxLength="15"/>
              </StackPanel>

              <StackPanel Grid.Row="1"
                          Grid.Column="1"
                          Margin="0,0,0,14">
                <TextBlock Text="Vai trò"
                           Style="{StaticResource Label}"/>
                <ComboBox x:Name="cboNewRole"
                          Height="34"
                          Padding="8,5"/>
              </StackPanel>

              <Border Grid.Row="2"
                      Grid.ColumnSpan="2"
                      Background="#EFF6FF"
                      BorderBrush="#BFDBFE"
                      BorderThickness="1"
                      CornerRadius="3"
                      Padding="14,18">
                <TextBlock Text="Hệ thống tạo mật khẩu ngẫu nhiên gửi về email người dùng và lưu tài khoản."
                           Foreground="#2563EB"
                           TextWrapping="Wrap"/>
              </Border>
            </Grid>

            <Border Padding="14,12"
                    BorderBrush="#E1E5EC"
                    BorderThickness="0,1,0,0">
              <StackPanel Orientation="Horizontal"
                          HorizontalAlignment="Right">
                <Button x:Name="btnRetryEmail"
                        Content="Gửi lại email"
                        Visibility="Collapsed"
                        Click="RetryEmail_Click"
                        Margin="0,0,8,0"/>

                <Button Content="Tạo tài khoản mới"
                        Background="#2563EB"
                        Foreground="White"
                        Click="CreateAccount_Click"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <TextBlock x:Name="txtStatus"
               Grid.Row="1"
               Foreground="#B45309"
               TextWrapping="Wrap"
               Margin="0,12,0,0"/>
  </Grid>
</UserControl>