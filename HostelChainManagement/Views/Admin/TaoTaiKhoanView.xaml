<UserControl x:Class="QuanLyChuoiNhaTro.Views.Admin.TaoTaiKhoanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8F9FB"
             Loaded="View_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel x:Name="editorPanel"
                        MaxWidth="850">

                <TextBlock Text="Tạo tài khoản mới"
                           FontSize="22"
                           FontWeight="SemiBold"/>

                <TextBlock
                    Text="Nhập thông tin tài khoản người dùng cần tạo."
                    Foreground="#7C8798"
                    Margin="0,4,0,12"
                    TextWrapping="Wrap"/>

                <Border Background="White"
                        BorderBrush="#D1D7E0"
                        BorderThickness="1"
                        CornerRadius="3">

                    <StackPanel>
                        <Border Padding="14,11"
                                BorderBrush="#E1E5EC"
                                BorderThickness="0,0,0,1">

                            <TextBlock Text="Thông tin tài khoản"
                                       FontWeight="SemiBold"/>
                        </Border>

                        <Grid x:Name="accountFields"
                              Margin="16">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Margin="0,0,14,14">
                                <TextBlock Text="Họ và tên"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,6"/>

                                <TextBox x:Name="txtFullName"
                                         MaxLength="100"
                                         Padding="10,7"
                                         MinHeight="36"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Margin="0,0,0,14">

                                <TextBlock Text="CCCD"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,6"/>

                                <TextBox x:Name="txtCccd"
                                         MaxLength="12"
                                         Padding="10,7"
                                         MinHeight="36"
                                         ToolTip="Nhập đúng 12 chữ số"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1"
                                        Margin="0,0,14,14">

                                <TextBlock Text="Tên đăng nhập"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,6"/>

                                <TextBox x:Name="txtNewLogin"
                                         MaxLength="50"
                                         Padding="10,7"
                                         MinHeight="36"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="0,0,0,14">

                                <TextBlock Text="Email (không bắt buộc)"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,6"/>

                                <TextBox x:Name="txtNewEmail"
                                         MaxLength="100"
                                         Padding="10,7"
                                         MinHeight="36"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2"
                                        Margin="0,0,14,14">

                                <TextBlock Text="SĐT"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,6"/>

                                <TextBox x:Name="txtNewPhone"
                                         MaxLength="15"
                                         Padding="10,7"
                                         MinHeight="36"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2"
                                        Grid.Column="1"
                                        Margin="0,0,0,14">

                                <TextBlock Text="Vai trò"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,6"/>

                                <ComboBox x:Name="cboNewRole"
                                          Padding="8,5"
                                          MinHeight="36"
                                          SelectionChanged="Role_Changed"/>
                            </StackPanel>

                            <StackPanel x:Name="dayPanel"
                                        Grid.Row="3"
                                        Grid.ColumnSpan="2"
                                        Margin="0,0,0,14"
                                        Visibility="Collapsed">

                                <TextBlock x:Name="txtDayLabel"
                                           Text="Dãy trọ"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,6"/>

                                <ComboBox x:Name="cboDay"
                                          DisplayMemberPath="TenDayTro"
                                          SelectedValuePath="MaDayTro"
                                          Padding="8,5"
                                          MinHeight="36"/>
                            </StackPanel>

                            <Border Grid.Row="4"
                                    Grid.ColumnSpan="2"
                                    Background="#EFF6FF"
                                    BorderBrush="#BFDBFE"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="14,18">

                                <TextBlock
                                    Text="Hệ thống tạo mật khẩu ngẫu nhiên. Nếu có email, thông tin đăng nhập được gửi qua email; nếu không có email, thông tin sẽ hiển thị cho Admin sau khi tạo."
                                    Foreground="#2563EB"
                                    TextWrapping="Wrap"/>
                            </Border>
                        </Grid>

                        <Border Padding="14,12"
                                BorderBrush="#E1E5EC"
                                BorderThickness="0,1,0,0">

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right">

                                <Button x:Name="btnRetryEmail"
                                        Content="Gửi lại email"
                                        Visibility="Collapsed"
                                        Padding="14,8"
                                        Margin="0,0,8,0"
                                        Click="RetryEmail_Click"/>

                                <Button x:Name="btnCreate"
                                        Content="Tạo tài khoản mới"
                                        Background="#2563EB"
                                        BorderBrush="#2563EB"
                                        Foreground="White"
                                        Padding="14,8"
                                        Click="CreateAccount_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="txtStatus"
                   Grid.Row="1"
                   Foreground="#B45309"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0"/>
    </Grid>
</UserControl>