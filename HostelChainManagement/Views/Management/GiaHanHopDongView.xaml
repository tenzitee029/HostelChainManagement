<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="QuanLyChuoiNhaTro.Views.Management.GiaHanHopDongView"
             Loaded="View_Loaded"
             Background="#F8FAFC" d:DesignWidth="849.188">

    <UserControl.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#475569"/>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Margin" Value="0,6,0,16"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>

        <Style TargetType="{x:Type Button}">
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">
            <TextBlock Text="Gia hạn hợp đồng"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#0F172A"/>

            <TextBlock Text="Cập nhật thời hạn mới cho hợp đồng đang hiệu lực."
                       Margin="0,6,0,20"/>

            <Border Background="White"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="4">
                <StackPanel>
                    <Border Padding="18,14"
                            BorderBrush="#E2E8F0"
                            BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="Thông tin hợp đồng hiện tại"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Hợp đồng được chọn để thực hiện gia hạn."
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="Mã hợp đồng"/>
                                <TextBox x:Name="txtMaHopDong"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Trạng thái"/>
                                <TextBox x:Name="txtTrangThai"
                                         Foreground="#15803D"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1">
                                <TextBlock Text="Khách thuê"/>
                                <TextBox x:Name="txtKhachThue"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Text="Phòng"/>
                                <TextBox x:Name="txtPhong"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2">
                                <TextBlock Text="Ngày bắt đầu"/>
                                <TextBox x:Name="txtNgayBatDau"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="Ngày kết thúc hiện tại"/>
                                <TextBox x:Name="txtNgayKetThuc"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="#EFF6FF"
                                BorderBrush="#BFDBFE"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="16">
                            <StackPanel>
                                <TextBlock Text="Thời hạn gia hạn"
                                           Foreground="#2563EB"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="Ngày kết thúc mới *"
                                           Margin="0,12,0,6"/>

                                <DatePicker x:Name="dpKetThucMoi"
                                            SelectedDateFormat="Short"
                                            MinHeight="40"
                                            IsEnabled="False"/>

                                <TextBlock
                                    Text="Ngày mới phải sau ngày kết thúc hiện tại. Giá thuê và tiền cọc được giữ nguyên."
                                    Margin="0,10,0,0"
                                    Foreground="#64748B"
                                    TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="txtThongBao"
                                   Margin="0,12,0,0"
                                   Foreground="#DC2626"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border BorderBrush="#E2E8F0"
                            BorderThickness="0,1,0,0"
                            Padding="16">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button x:Name="btnQuayLai"
                                    Content="Quay lại"
                                    Background="#64748B"
                                    Click="QuayLai_Click"/>

                            <Button x:Name="btnLuu"
                                    Content="Xác nhận gia hạn"
                                    IsEnabled="False"
                                    Click="Luu_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>