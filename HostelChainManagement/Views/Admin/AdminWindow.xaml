<Window x:Class="QuanLyChuoiNhaTro.Views.Admin.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin hệ thống — Quản lý nhà trọ"
        Width="1200"
        Height="760"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FB"
        FontFamily="Segoe UI"
        Foreground="#182132"
        Loaded="Window_Loaded">

  <Window.Resources>
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Foreground" Value="#CBD5E1"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="Margin" Value="8,3"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    CornerRadius="2"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#CFD6E1"/>
      <Setter Property="Foreground" Value="#475569"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style x:Key="PrimaryButton"
           TargetType="Button"
           BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#2563EB"/>
      <Setter Property="BorderBrush" Value="#2563EB"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="BorderBrush" Value="#D1D7E0"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ReadField"
           TargetType="TextBox"
           BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="Background" Value="#F8F9FB"/>
      <Setter Property="Foreground" Value="#64748B"/>
    </Style>

    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#475569"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#D1D7E0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="3"/>
    </Style>

    <Style x:Key="CardHeader" TargetType="Border">
      <Setter Property="Padding" Value="14,11"/>
      <Setter Property="BorderBrush" Value="#E1E5EC"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style TargetType="DataGrid">
      <Setter Property="AutoGenerateColumns" Value="False"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="CanUserDeleteRows" Value="False"/>
      <Setter Property="SelectionMode" Value="Single"/>
      <Setter Property="SelectionUnit" Value="FullRow"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HorizontalGridLinesBrush" Value="#E5E7EB"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="RowHeight" Value="38"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#F3F4F6"/>
      <Setter Property="Foreground" Value="#475569"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Padding" Value="8,12"/>
      <Setter Property="BorderBrush" Value="#D1D7E0"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style TargetType="DataGridCell">
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- RadioButton dạng thẻ theo Hình 93 -->
    <Style TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="TaskBorder"
                    BorderBrush="#D1D7E0"
                    BorderThickness="1"
                    CornerRadius="3"
                    Background="White"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>

            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="TaskBorder"
                        Property="BorderBrush"
                        Value="#2563EB"/>
                <Setter TargetName="TaskBorder"
                        Property="Background"
                        Value="#EFF6FF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="192"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- THANH BÊN -->
    <Border Background="#1E293B">
      <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="#0F172A"
                Height="60"
                Padding="15,10">
          <StackPanel Orientation="Horizontal">
            <Border Background="#2563EB"
                    Width="34"
                    Height="34"
                    CornerRadius="3">
              <TextBlock Text="NT"
                         Foreground="White"
                         FontWeight="Bold"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
            </Border>

            <StackPanel Margin="9,0,0,0"
                        VerticalAlignment="Center">
              <TextBlock Text="QUẢN LÝ NHÀ TRỌ"
                         Foreground="White"
                         FontSize="11"
                         FontWeight="Bold"/>
              <TextBlock Text="Hệ thống quản lý"
                         Foreground="#94A3B8"
                         FontSize="9"
                         Margin="0,3,0,0"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                BorderBrush="#334155"
                BorderThickness="0,1,0,0"
                Padding="0,10">
          <Button Content="↪   Đăng xuất"
                  Foreground="#FCA5A5"
                  Style="{StaticResource NavButton}"
                  Click="Logout_Click"/>
        </Border>

        <StackPanel x:Name="navPanel"
                    Margin="0,18,0,0">
          <TextBlock Text="QUẢN TRỊ HỆ THỐNG"
                     Foreground="#94A3B8"
                     FontSize="9"
                     FontWeight="SemiBold"
                     Margin="17,0,0,5"/>

          <Button x:Name="btnMaintenance"
                  Content="⚙   Bảo trì hệ thống"
                  Background="#2563EB"
                  Foreground="White"
                  Style="{StaticResource NavButton}"
                  Click="Maintenance_Click"/>

          <Button x:Name="btnAccounts"
                  Content="▦   Quản lý tài khoản"
                  Style="{StaticResource NavButton}"
                  Click="Accounts_Click"/>

          <Border Height="1"
                  Background="#334155"
                  Margin="8,12"/>

          <TextBlock Text="TÀI KHOẢN"
                     Foreground="#94A3B8"
                     FontSize="9"
                     FontWeight="SemiBold"
                     Margin="17,0,0,5"/>

          <Button x:Name="btnProfile"
                  Content="⚙   Hồ sơ cá nhân"
                  Style="{StaticResource NavButton}"
                  Click="Profile_Click"/>

          <Button x:Name="btnPassword"
                  Content="▣   Đổi mật khẩu"
                  Style="{StaticResource NavButton}"
                  Click="Password_Click"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="60"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- THANH ĐẦU TRANG -->
      <Border Background="White"
              BorderBrush="#E1E5EC"
              BorderThickness="0,0,0,1"
              Padding="20,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right"
                      Orientation="Horizontal"
                      VerticalAlignment="Center">
            <Button x:Name="btnBell"
                    Content="🔔"
                    ToolTip="Thông báo"
                    Padding="7,5"
                    Click="Bell_Click"
                    Margin="0,0,12,0"/>

            <Border Background="#DBEAFE"
                    Width="30"
                    Height="30"
                    CornerRadius="15"
                    Margin="0,0,8,0">
              <TextBlock Text="AD"
                         Foreground="#2563EB"
                         FontSize="11"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
            </Border>

            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="txtUser"
                         FontSize="11"
                         FontWeight="SemiBold"/>
              <TextBlock Text="Admin hệ thống"
                         FontSize="9"
                         Foreground="#94A3B8"/>
            </StackPanel>
          </StackPanel>

          <TextBlock x:Name="txtBreadcrumb"
                     Text="Hệ thống / Bảo trì hệ thống"
                     Foreground="#64748B"
                     FontSize="11"
                     VerticalAlignment="Center"/>
        </DockPanel>
      </Border>

      <Grid Grid.Row="1"
            x:Name="contentPanel"
            Margin="20,18,20,20">

        <!-- HÌNH 93: BẢO TRÌ HỆ THỐNG -->
        <ScrollViewer x:Name="maintenancePanel"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Width="{Binding ActualWidth, ElementName=contentPanel}"
                      MaxWidth="850"
                      HorizontalAlignment="Left">

            <TextBlock Text="Bảo trì hệ thống"
                       FontSize="22"
                       FontWeight="SemiBold"/>

            <TextBlock Text="Chọn tác vụ bảo trì hệ thống cần thực hiện."
                       Foreground="#7C8798"
                       FontSize="11"
                       Margin="0,4,0,12"/>

            <Border Style="{StaticResource Card}"
                    Margin="0,0,0,14">
              <StackPanel>
                <Border Style="{StaticResource CardHeader}">
                  <TextBlock Text="Tác vụ bảo trì"
                             FontWeight="SemiBold"/>
                </Border>

                <UniformGrid Columns="2"
                             Margin="12">
                  <RadioButton Content="Sao lưu CSDL (Backup)"
                               Tag="Backup"
                               GroupName="Maintenance"
                               Checked="Task_Checked"
                               Padding="14,22"
                               Margin="5"/>

                  <RadioButton Content="Khôi phục CSDL (Restore)"
                               Tag="Restore"
                               GroupName="Maintenance"
                               Checked="Task_Checked"
                               Padding="14,22"
                               Margin="5"/>

                  <RadioButton Content="Xem nhật ký hệ thống (System Logs)"
                               Tag="Logs"
                               GroupName="Maintenance"
                               Checked="Task_Checked"
                               Padding="14,22"
                               Margin="5"/>

                  <RadioButton Content="Dọn dẹp tệp tạm"
                               Tag="Cache"
                               GroupName="Maintenance"
                               Checked="Task_Checked"
                               Padding="14,22"
                               Margin="5"/>
                </UniformGrid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <Border Style="{StaticResource CardHeader}">
                  <TextBlock Text="Xác nhận thao tác"
                             FontWeight="SemiBold"/>
                </Border>

                <Grid Margin="16,20">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>

                  <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Tác vụ đã chọn"
                               Style="{StaticResource Label}"/>
                    <TextBox x:Name="txtTask"
                             Text="—"
                             Style="{StaticResource ReadField}"/>
                  </StackPanel>

                  <Button Grid.Column="1"
                          Content="Xác nhận thực hiện"
                          Style="{StaticResource PrimaryButton}"
                          Click="ExecuteTask_Click"
                          VerticalAlignment="Bottom"/>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- HÌNH 95: XEM NHẬT KÝ HỆ THỐNG -->
        <Grid x:Name="logsPanel"
              Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal">
              <Button Content="Xuất file text"
                      Click="ExportText_Click"
                      Foreground="#2563EB"
                      Margin="0,0,8,0"/>
              <Button Content="Xuất Excel"
                      Click="ExportExcel_Click"
                      Foreground="#2563EB"/>
            </StackPanel>

            <StackPanel>
              <TextBlock Text="Xem nhật ký hệ thống"
                         FontSize="22"
                         FontWeight="SemiBold"/>
              <TextBlock Text="Theo dõi log truy cập và log lỗi runtime của hệ thống."
                         Foreground="#7C8798"
                         FontSize="11"
                         Margin="0,4,0,0"/>
            </StackPanel>
          </DockPanel>

          <Border Grid.Row="1"
                  Style="{StaticResource Card}"
                  Padding="14,12"
                  Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Loại nhật ký"
                         Style="{StaticResource Label}"/>

              <ComboBox x:Name="cboLogType"
                        Width="260"
                        Height="34"
                        HorizontalAlignment="Left"
                        Padding="8,5"
                        SelectionChanged="LogFilter_Changed">
                <ComboBoxItem Content="Log truy cập"
                              IsSelected="True"/>
                <ComboBoxItem Content="Log lỗi runtime"/>
                <ComboBoxItem Content="Quản trị"/>
                <ComboBoxItem Content="Tất cả"/>
              </ComboBox>
            </StackPanel>
          </Border>

          <Border Grid.Row="2"
                  Style="{StaticResource Card}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <Border Style="{StaticResource CardHeader}">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right"
                              Orientation="Horizontal"
                              VerticalAlignment="Center">
                    <Border Background="#DBEAFE"
                            BorderBrush="#93C5FD"
                            BorderThickness="1"
                            Padding="7,4"
                            Margin="0,0,6,0">
                      <TextBlock Text="LOG TRUY CẬP"
                                 Foreground="#2563EB"
                                 FontSize="9"
                                 FontWeight="SemiBold"/>
                    </Border>

                    <Border Background="#FEE2E2"
                            BorderBrush="#FCA5A5"
                            BorderThickness="1"
                            Padding="7,4">
                      <TextBlock Text="LOG LỖI RUNTIME"
                                 Foreground="#B91C1C"
                                 FontSize="9"
                                 FontWeight="SemiBold"/>
                    </Border>
                  </StackPanel>

                  <StackPanel>
                    <TextBlock Text="Danh sách nhật ký"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Nhật ký truy cập và lỗi runtime được ghi nhận trong hệ thống."
                               Foreground="#94A3B8"
                               FontSize="10"
                               Margin="0,3,0,0"/>
                  </StackPanel>
                </DockPanel>
              </Border>

              <DataGrid Grid.Row="1"
                        x:Name="logsGrid">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Loại nhật ký"
                                      Binding="{Binding LoaiNhatKy}"
                                      Width="165"/>
                  <DataGridTextColumn Header="Nội dung nhật ký"
                                      Binding="{Binding NoiDung}"
                                      Width="*"/>
                </DataGrid.Columns>
              </DataGrid>

              <TextBlock Grid.Row="1"
                         x:Name="txtNoLogs"
                         Text="—"
                         Foreground="#94A3B8"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         IsHitTestVisible="False"/>

              <Border Grid.Row="2"
                      BorderBrush="#E1E5EC"
                      BorderThickness="0,1,0,0"
                      Padding="14">
                <TextBlock Text="Nhật ký hệ thống thuộc chức năng bảo trì hệ thống."
                           Foreground="#94A3B8"
                           FontSize="10"/>
              </Border>
            </Grid>
          </Border>
        </Grid>

        <!-- HÌNH 97: QUẢN LÝ TÀI KHOẢN -->
        <Grid x:Name="accountsPanel"
              Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right"
                    Content="Tạo tài khoản mới"
                    Style="{StaticResource PrimaryButton}"
                    Click="NewAccount_Click"
                    VerticalAlignment="Top"/>

            <StackPanel>
              <TextBlock Text="Quản lý tài khoản"
                         FontSize="22"
                         FontWeight="SemiBold"/>
              <TextBlock Text="Quản lý thông tin, vai trò và trạng thái tài khoản người dùng."
                         Foreground="#7C8798"
                         FontSize="11"
                         Margin="0,4,0,0"/>
            </StackPanel>
          </DockPanel>

          <Border Grid.Row="1"
                  Style="{StaticResource Card}"
                  Margin="0,0,0,14">
            <StackPanel>
              <Border Style="{StaticResource CardHeader}">
                <TextBlock Text="Bộ lọc"
                           FontWeight="SemiBold"/>
              </Border>

              <Grid Margin="14,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.2*"/>
                  <ColumnDefinition/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,12,0">
                  <TextBlock Text="Tên đăng nhập"
                             Style="{StaticResource Label}"/>
                  <TextBox x:Name="txtSearch"
                           TextChanged="AccountSearch_Changed"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="0,0,12,0">
                  <TextBlock Text="Vai trò"
                             Style="{StaticResource Label}"/>
                  <ComboBox x:Name="cboRoleFilter"
                            Height="34"
                            Padding="8,5"
                            SelectionChanged="AccountFilter_Changed"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                  <TextBlock Text="Trạng thái"
                             Style="{StaticResource Label}"/>
                  <ComboBox x:Name="cboStatus"
                            Height="34"
                            Padding="8,5"
                            SelectionChanged="AccountFilter_Changed">
                    <ComboBoxItem Content="Tất cả trạng thái"
                                  IsSelected="True"/>
                    <ComboBoxItem Content="Hoạt động"/>
                    <ComboBoxItem Content="Khóa"/>
                    <ComboBoxItem Content="Ngừng sử dụng"/>
                  </ComboBox>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <Border Grid.Row="2"
                  Style="{StaticResource Card}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <Border Style="{StaticResource CardHeader}">
                <TextBlock Text="Danh sách tài khoản"
                           FontWeight="SemiBold"/>
              </Border>

              <DataGrid Grid.Row="1"
                        x:Name="accountsGrid">
                <DataGrid.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Cập nhật vai trò"
                              Click="ChangeRole_Click"/>
                  </ContextMenu>
                </DataGrid.ContextMenu>

                <DataGrid.Columns>
                  <DataGridTextColumn Header="Tên tài khoản"
                                      Binding="{Binding TenDangNhap}"
                                      Width="*"/>

                  <DataGridTextColumn Header="Người sử dụng"
                                      Binding="{Binding HoTen}"
                                      Width="*"/>

                  <DataGridTextColumn Header="Vai trò"
                                      Binding="{Binding VaiTro}"
                                      Width="155"/>

                  <DataGridTextColumn Header="Trạng thái"
                                      Binding="{Binding TrangThai}"
                                      Width="115"/>

                  <DataGridTemplateColumn Header="Khóa / Mở khóa"
                                          Width="125">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Button Click="ToggleStatus_Click"
                                Padding="8,3"
                                Margin="4">
                          <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource {x:Type Button}}">
                              <Setter Property="Content"
                                      Value="Khóa"/>

                              <Style.Triggers>
                                <DataTrigger Binding="{Binding TrangThai}"
                                             Value="Khóa">
                                  <Setter Property="Content"
                                          Value="Mở khóa"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding TrangThai}"
                                             Value="Ngừng sử dụng">
                                  <Setter Property="Content"
                                          Value="Mở khóa"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Button.Style>
                        </Button>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>

              <TextBlock Grid.Row="1"
                         x:Name="txtNoAccounts"
                         Text="—"
                         Foreground="#94A3B8"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         IsHitTestVisible="False"/>
            </Grid>
          </Border>
        </Grid>

        <!-- HÌNH 99: TẠO TÀI KHOẢN MỚI -->
        <ScrollViewer x:Name="createPanel"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Width="{Binding ActualWidth, ElementName=contentPanel}"
                      MaxWidth="750"
                      HorizontalAlignment="Left">

            <TextBlock Text="Tạo tài khoản mới"
                       FontSize="22"
                       FontWeight="SemiBold"/>

            <TextBlock Text="Nhập thông tin tài khoản người dùng cần tạo."
                       Foreground="#7C8798"
                       FontSize="11"
                       Margin="0,4,0,12"/>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <Border Style="{StaticResource CardHeader}">
                  <TextBlock Text="Thông tin tài khoản"
                             FontWeight="SemiBold"/>
                </Border>

                <Grid Margin="16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                  </Grid.ColumnDefinitions>

                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                  <StackPanel Margin="0,0,14,14">
                    <TextBlock Text="Tên đăng nhập"
                               Style="{StaticResource Label}"/>
                    <TextBox x:Name="txtNewLogin"
                             MaxLength="50"/>
                  </StackPanel>

                  <StackPanel Grid.Column="1"
                              Margin="0,0,0,14">
                    <TextBlock Text="Email"
                               Style="{StaticResource Label}"/>
                    <TextBox x:Name="txtNewEmail"
                             MaxLength="100"/>
                  </StackPanel>

                  <StackPanel Grid.Row="1"
                              Margin="0,0,14,14">
                    <TextBlock Text="SĐT"
                               Style="{StaticResource Label}"/>
                    <TextBox x:Name="txtNewPhone"
                             MaxLength="15"/>
                  </StackPanel>

                  <StackPanel Grid.Row="1"
                              Grid.Column="1"
                              Margin="0,0,0,14">
                    <TextBlock Text="Vai trò"
                               Style="{StaticResource Label}"/>
                    <ComboBox x:Name="cboNewRole"
                              Height="34"
                              Padding="8,5"/>
                  </StackPanel>

                  <Border Grid.Row="2"
                          Grid.ColumnSpan="2"
                          Background="#EFF6FF"
                          BorderBrush="#BFDBFE"
                          BorderThickness="1"
                          CornerRadius="3"
                          Padding="14,18">
                    <TextBlock Text="Hệ thống tạo mật khẩu ngẫu nhiên gửi về email người dùng và lưu tài khoản."
                               Foreground="#2563EB"
                               FontSize="11"
                               TextWrapping="Wrap"/>
                  </Border>
                </Grid>

                <Border BorderBrush="#E1E5EC"
                        BorderThickness="0,1,0,0"
                        Padding="14,12">
                  <StackPanel Orientation="Horizontal"
                              HorizontalAlignment="Right">
                    <Button x:Name="btnRetryEmail"
                            Content="Gửi lại email"
                            Visibility="Collapsed"
                            Click="RetryEmail_Click"
                            Margin="0,0,8,0"/>

                    <Button Content="Tạo tài khoản mới"
                            Style="{StaticResource PrimaryButton}"
                            Click="CreateAccount_Click"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ContentControl x:Name="profilePanel"
                        Visibility="Collapsed"/>

        <StackPanel x:Name="passwordPanel"
                    Visibility="Collapsed"
                    Width="400"
                    HorizontalAlignment="Left">
          <TextBlock Text="Đổi mật khẩu"
                     FontSize="22"
                     FontWeight="SemiBold"
                     Margin="0,0,0,20"/>

          <TextBlock Text="Mật khẩu hiện tại"
                     Style="{StaticResource Label}"/>
          <PasswordBox x:Name="oldPassword"
                       Padding="8"
                       Margin="0,0,0,16"/>

          <TextBlock Text="Mật khẩu mới"
                     Style="{StaticResource Label}"/>
          <PasswordBox x:Name="newPassword"
                       Padding="8"
                       Margin="0,0,0,16"/>

          <TextBlock Text="Nhập lại mật khẩu mới"
                     Style="{StaticResource Label}"/>
          <PasswordBox x:Name="confirmPassword"
                       Padding="8"
                       Margin="0,0,0,16"/>

          <Button Content="Lưu mật khẩu"
                  Style="{StaticResource PrimaryButton}"
                  Click="ChangePassword_Click"
                  HorizontalAlignment="Left"/>
        </StackPanel>
      </Grid>

      <TextBlock Grid.Row="2"
                 x:Name="txtStatus"
                 Foreground="#1D4ED8"
                 TextWrapping="Wrap"
                 Margin="20,0,20,12"/>
    </Grid>
  </Grid>
</Window>